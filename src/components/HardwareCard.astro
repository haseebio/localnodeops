---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'hardware'>;
}

const { entry } = Astro.props;
const { title, category, metricLabel, metricValue, status, summary } = entry.data;

const STATUS_LABELS: Record<string, string> = {
  verified: 'Verified',
  community: 'Community-reported',
  estimated: 'Estimated — not yet benchmarked',
};

// Filled, tinted backgrounds instead of a thin 1px outline — same
// WCAG-checked container colors used elsewhere on the site
// (accent-tertiary-container, accent-secondary-container). Text is
// text-primary (charcoal) rather than an "-on-container" variant —
// those aren't mapped Tailwind utilities in this project (see the
// article-action-btn comment in global.css for the same issue), and
// charcoal reads safely against any of these light pastel fills.
const STATUS_STYLES: Record<string, string> = {
  verified: 'bg-accent-tertiary-container text-primary',
  community: 'bg-surface-elevated text-secondary border border-border',
  estimated: 'bg-accent-secondary-container text-primary',
};
---

<a href={`/hardware/${entry.slug}`}
  data-astro-prefetch
  class="group h-full flex flex-col gap-sm border border-border rounded-md bg-surface p-md
    no-underline cursor-pointer transition-colors
    hover:border-accent-primary hover:bg-surface-elevated"
  data-category={category}
>
  <div class="flex flex-wrap items-center justify-between gap-x-sm gap-y-xs">
    <span class="text-body-md text-secondary">{category}</span>
    <span
      class:list={[
        'text-body-md rounded-full px-sm py-[0.125rem] text-center font-bold',
        STATUS_STYLES[status],
      ]}
    >
      {STATUS_LABELS[status]}
    </span>
  </div>

  <h3 class="text-headline-md text-primary m-0 group-hover:underline">
    {title}
  </h3>

  <div class="rounded-md bg-accent-primary-container px-sm py-xs font-mono w-fit">
    <span class="text-headline-lg text-accent-primary">{metricValue}</span>
    <span class="text-body-md text-primary ml-xs">{metricLabel}</span>
  </div>

  <p class="text-body-md text-secondary m-0 flex-1">{summary}</p>

  <span class="min-h-touch-min flex items-center justify-center rounded-md border
    border-accent-primary text-body-md font-bold text-accent-primary
    group-hover:bg-accent-primary-solid group-hover:text-accent-on-primary
    group-hover:border-accent-primary-solid transition-colors">
    View benchmark
  </span>
</a>