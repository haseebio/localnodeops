---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { title, excerpt, category, pubDate, readingTime, author } = entry.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/posts/${entry.slug}`}
  class="card-link group h-full flex flex-col gap-xs p-md no-underline cursor-pointer"
>
  <span class="kicker">{category}</span>

  <h3 class="text-headline-md text-primary m-0 group-hover:underline">
    {title}
  </h3>

  <p class="text-body-md text-secondary m-0 flex-1">{excerpt}</p>

  {entry.data.keyNumber && (
    <p class="num m-0 text-accent-primary" style="font-size:.85rem;font-weight:700">{entry.data.keyNumber}</p>
  )}

  <div class="flex flex-wrap items-center gap-x-xs gap-y-[0.125rem] pt-sm border-t border-border-subtle text-body-md text-secondary">
    <span class="text-primary font-bold">{author}</span>
    <span aria-hidden="true">·</span>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
  </div>
</a>
