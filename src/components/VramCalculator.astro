---
import { getCollection } from 'astro:content';
import CloudFallbackCTA from './CloudFallbackCTA.astro';
import { getModelArch } from '../lib/vram-math';
import { AMAZON_AFFILIATE_TAG } from '../lib/affiliate';

interface Props {
  // Optional slug from the `models` collection. When set, the
  // calculator opens pre-selected to that model instead of defaulting
  // to "Generic estimate" — used by /calculator/[slug].astro.
  preselectedModel?: string;
}

const { preselectedModel } = Astro.props;

// Same button style as CloudFallbackCTA.astro's BTN_PRIMARY.
const BTN_PRIMARY =
  'inline-flex items-center justify-center min-h-touch-min rounded-full px-lg font-semibold text-body-md text-center no-underline cursor-pointer bg-accent-primary-solid text-accent-on-primary transition-transform hover:-translate-y-[1px]';

const modelEntries = await getCollection('models');
const models = modelEntries.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  lastSynced: entry.data.last_synced,
  quantizations: entry.data.quantizations,
  // Per-model attention config from src/data/model-arch.json, or null.
  arch: getModelArch(entry.slug),
}));

const preselectedIndex = preselectedModel
  ? models.findIndex((m) => m.slug === preselectedModel)
  : -1;

const GPU_QUANTITIES = [1, 2, 3, 4, 5, 6, 7, 8];
const GPU_VRAM_OPTIONS = [6, 8, 12, 16, 24, 32, 48];
const SYSTEM_RAM_OPTIONS = [8, 16, 32, 64, 128, 256];
---

<div class="border border-border rounded-md bg-surface p-md" id="vram-calculator" data-amazon-tag={AMAZON_AFFILIATE_TAG}>
  <h2 class="text-headline-lg text-primary m-0">VRAM calculator</h2>
  <p class="text-body-md text-secondary mt-xs mb-md">
    Estimate total VRAM for a given model size, quantization, and context
    length. Estimates only — see the note at the bottom.
  </p>

  <div class="mb-md">
    <label for="model-source" class="text-body-md text-primary block mb-xs">
      Weight size source
    </label>
    <select
      id="model-source"
      class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
    >
      <option value="generic" selected={preselectedIndex === -1}>Generic estimate (by parameter count)</option>
      {models.map((model, index) => (
        <option value={`model:${index}`} selected={index === preselectedIndex}>{model.title} (exact, synced from HF)</option>
      ))}
    </select>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
    <div class="flex flex-col gap-lg">
      <div id="generic-model-size-row">
        <label for="model-size" class="text-body-md text-primary block mb-xs">
          Model size: <span id="model-size-label" class="font-mono text-accent-primary">7B</span>
        </label>
        <input
  type="range"
  id="model-size"
  min="0"
  max="4"
  step="1"
  value="0"
  class="w-full"
  aria-valuetext="7B"
/>
<div class="flex justify-between text-body-md text-secondary mt-[0.125rem]">
  <span>7B</span><span>13B</span><span>32B</span><span>70B</span><span>120B</span>
</div>

      <div id="generic-quant-row">
        <label for="quant" class="text-body-md text-primary block mb-xs">
          Quantization
        </label>
        <select
          id="quant"
          class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
        >
          <option value="16">FP16 (16 bpw)</option>
          <option value="8.5">Q8_0 (~8.5 bpw)</option>
          <option value="4.83" selected>Q4_K_M (~4.83 bpw)</option>
          <option value="4">EXL2 4.0bpw (exact)</option>
        </select>
      </div>

      <div id="model-quant-row" class="hidden">
        <label for="model-quant" class="text-body-md text-primary block mb-xs">
          Quantization (exact file size)
        </label>
        <select
          id="model-quant"
          class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
        ></select>
        <p class="text-body-md text-secondary mt-xs" id="model-match-note"></p>
      </div>

      <div>
        <label for="context" class="text-body-md text-primary block mb-xs">
          Context length: <span id="context-label" class="font-mono text-accent-primary">4096</span> tokens
        </label>
        <input
          type="range"
          id="context"
          min="0"
          max="7"
          step="1"
          value="1"
          class="w-full"
          aria-valuetext="4096 tokens"
        />
        <div class="flex justify-between text-body-md text-secondary mt-[0.125rem]">
          <span>2K</span><span>4K</span><span>8K</span><span>16K</span><span>32K</span><span>64K</span><span>128K</span><span>256K</span>
        </div>
        <p class="text-body-md text-secondary mt-xs hidden" id="context-note"></p>
      </div>

      <fieldset class="border-0 p-0 m-0">
        <legend class="text-body-md text-primary mb-xs p-0">Inference engine</legend>
        <div class="flex gap-md">
          <label class="flex items-center gap-xs text-body-lg text-primary cursor-pointer">
            <input type="radio" name="engine" id="engine-llamacpp" value="llamacpp" checked />
            llama.cpp
          </label>
          <label class="flex items-center gap-xs text-body-lg text-primary cursor-pointer">
            <input type="radio" name="engine" id="engine-vllm" value="vllm" />
            vLLM
          </label>
        </div>
        <p class="text-body-md text-secondary mt-xs" id="engine-note"></p>
      </fieldset>
    </div>

    <!--
      Total Required VRAM is UNCONDITIONAL — visible as soon as a model
      is selected, no hardware choice required (progressive disclosure:
      Task 1). Everything about matching it to real hardware and its
      cost lives inside the <dialog> below, opened only on request.
    -->
    <div class="flex flex-col gap-sm">
      <div class="border border-border rounded-md bg-surface-elevated p-md">
        <p class="text-body-md text-primary font-bold m-0 mb-xs">Total required VRAM</p>
        <dl class="grid grid-cols-2 gap-y-xs text-body-md">
          <dt class="text-secondary">Model weights</dt>
          <dd class="text-primary font-mono text-right" id="out-weights">—</dd>

          <dt class="text-secondary">KV cache</dt>
          <dd class="text-primary font-mono text-right" id="out-kv">—</dd>

          <dt class="text-secondary">Runtime overhead (10%)</dt>
          <dd class="text-primary font-mono text-right" id="out-overhead">—</dd>

          <dt class="text-primary font-bold border-t border-border pt-xs mt-xs">Total VRAM</dt>
          <dd class="text-accent-primary font-mono text-right font-bold border-t border-border pt-xs mt-xs" id="out-total">—</dd>

          <dt class="text-secondary hidden" id="out-required-label">GPU VRAM needed (total ÷ 0.90)</dt>
          <dd class="text-primary font-mono text-right hidden" id="out-required">—</dd>
        </dl>
        <div id="fit-status" class="mt-sm text-body-md hidden" role="status"></div>
        <button
          type="button"
          id="open-hardware-modal"
          class={`${BTN_PRIMARY} mt-md w-full`}
        >
          Check Hardware &amp; Cloud Budget
        </button>
      </div>
    </div>
  </div>

  <!--
    Everything hardware/budget-related lives in this dialog, opened only
    on request (Task 1: progressive disclosure). Native <dialog> gives
    focus trapping and Escape-to-close for free. This project disables
    Tailwind's preflight (astro.config.mjs: applyBaseStyles: false), so
    the browser's UA stylesheet for <dialog> (its own border/background/
    position) is NOT reset automatically — the classes below explicitly
    override every property that matters (border, bg, width, padding),
    verified against the compiled CSS, but the actual rendered look
    still needs a live check same as any other visual change.
  -->
  <dialog
    id="hardware-modal"
    aria-labelledby="hardware-modal-title"
    class="backdrop:bg-black/50 p-lg rounded-md border border-border bg-surface w-full max-w-2xl"
  >
    <div class="flex items-start justify-between gap-md mb-sm">
      <h3 id="hardware-modal-title" class="text-headline-md text-primary m-0">
        Check hardware compatibility &amp; budget
      </h3>
      <button
        type="button"
        id="close-hardware-modal"
        aria-label="Close"
        class="text-secondary hover:text-primary text-headline-md leading-none cursor-pointer bg-transparent border-0 p-0"
      >
        ×
      </button>
    </div>

    <div>
      <label for="gpu-qty" class="text-body-md text-primary block mb-xs">
        Number of GPUs (identical cards)
      </label>
      <select
        id="gpu-qty"
        class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
      >
        {GPU_QUANTITIES.map((n) => (
          <option value={String(n)} selected={n === 1}>{n}</option>
        ))}
      </select>
      <p class="text-body-md text-secondary mt-xs hidden" id="gpu-qty-note">
        Pooled VRAM assumes weights and KV cache split evenly across the
        cards (for example llama.cpp layer splitting). Real usage varies
        with the framework, the link between cards (PCIe vs NVLink), and
        per-card buffers, so treat pooled VRAM as an upper bound. Tensor
        parallelism in vLLM also generally needs the card count to divide
        the model's attention heads evenly, so counts like 3, 5, 6, or 7
        may not work there.
      </p>
    </div>

    <div class="mt-sm grid grid-cols-1 sm:grid-cols-2 gap-md">
      <div>
        <label for="gpu-vram" class="text-body-md text-primary block mb-xs">
          VRAM per card
        </label>
        <select
          id="gpu-vram"
          class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
        >
          <option value="" selected>Not set</option>
          {GPU_VRAM_OPTIONS.map((n) => (
            <option value={String(n)}>{n} GB</option>
          ))}
        </select>
      </div>
      <div>
        <label for="system-ram" class="text-body-md text-primary block mb-xs">
          System RAM
        </label>
        <select
          id="system-ram"
          class="w-full min-h-touch-min rounded-md border border-border bg-surface text-primary text-body-lg px-sm font-mono"
        >
          <option value="" selected>Not set</option>
          {SYSTEM_RAM_OPTIONS.map((n) => (
            <option value={String(n)}>{n} GB</option>
          ))}
        </select>
      </div>
    </div>
    <div id="fit-status-modal" class="mt-sm text-body-md hidden" role="status"></div>

    <div class="mt-sm">
      <p class="text-body-md text-primary mb-xs">Fits on:</p>
      <ul class="flex flex-col gap-[0.125rem]" id="out-profiles"></ul>
      <CloudFallbackCTA />
    </div>
  </dialog>

  <!-- Live change log — records each committed manipulation (slider
       release, dropdown selection) with the resulting total at that
       moment. Most recent first, capped at 8 entries. -->
  <div class="mt-md border-t border-border pt-sm">
    <p class="text-body-md text-primary mb-xs">Live changes</p>
    <ul id="change-log" class="flex flex-col gap-[0.125rem] text-body-md text-secondary font-mono max-h-40 overflow-y-auto">
      <li id="change-log-empty" class="text-secondary italic">No changes yet — adjust a control above.</li>
    </ul>
    <button
      type="button"
      id="open-hardware-modal-text"
      class="text-accent-primary hover:underline mt-xs bg-transparent border-0 p-0 cursor-pointer text-body-md"
    >
      View required hardware
    </button>
  </div>

  <p class="text-body-md text-secondary mt-md border-t border-border pt-sm">
    <strong class="text-primary">Generic estimate:</strong> weight size
    is bits-per-weight × parameter count; KV cache uses a reference
    architecture for the selected size bucket (7B/13B/70B: real published
    models; 120B: extrapolated, no real model exists at that exact
    size). <strong class="text-primary">Model-specific (HF-synced):</strong>
    weight size is the exact <code>.gguf</code> file size fetched from
    Hugging Face — no estimation. KV cache is <em>still estimated</em>.
    For models whose published attention config is recorded on this site
    (layers, KV heads, head dimension, and any sliding-window layout), it
    is computed from that config. For every other model the calculator
    falls back to the nearest reference bucket, but only when the model is
    within 5B parameters of a bucket and is not a mixture-of-experts
    model; otherwise no total is shown. Batch size is fixed at 1 in both
    modes. <strong class="text-primary">Multiple GPUs:</strong> pooled
    VRAM is the number of cards times the VRAM per card, compared against
    the same total (weights + KV cache + 10% overhead). <strong class="text-primary">Engines:</strong>
    llama.cpp reserves the KV cache for the full context when the model
    loads. vLLM reserves 90% of VRAM by default (so the GPU needs the
    total divided by 0.90) and allocates KV in 16-token blocks; its
    overhead reuses the same 10% estimate, and it usually serves
    safetensors rather than GGUF. <strong class="text-primary">Fit status:</strong>
    offload assumes about 4 GB of system RAM stays with the operating
    system. Treat all figures here as a starting estimate, not a guarantee. Full formula and known
    limitations: <a href="/methodology" class="text-accent-primary hover:underline">/methodology</a>.
  </p>
</div>

<script is:inline type="application/json" id="models-data" set:html={JSON.stringify(models)} />

<script is:inline>
  (function () {
    const MODEL_SIZES = [
  { label: '7B', params: 7e9, layers: 32, kvHeads: 8, headDim: 128 },
  { label: '13B', params: 13e9, layers: 40, kvHeads: 40, headDim: 128 },
  { label: '32B', params: 32e9, layers: 64, kvHeads: 8, headDim: 128 },
  { label: '70B', params: 70e9, layers: 80, kvHeads: 8, headDim: 128 },
  { label: '120B', params: 120e9, layers: 88, kvHeads: 8, headDim: 128 },
];

    // Same rules as nearestBucket() in src/lib/vram-math.ts — keep in sync.
    const BUCKET_DISTANCE_CAP_B = 5;
    const MOE_NAME_PATTERN = /\bmoe\b|mixtral|\d+x\d+b/i;

    const CONTEXT_LENGTHS = [2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144];

    // Every profile here is a single card someone can buy. The number-of-
    // GPUs dropdown multiplies them. group is the heading shown above it
    // in the "Fits on" list, so profiles of one group must sit together.
    // amazonQuery is what the Amazon CTA searches for. runpodEquivalent
    // is optional: the closest REAL RunPod catalog card at equal-or-
    // greater VRAM, with a rate checked against RunPod's own pricing page
    // (RunPod does not offer the RTX 3060 or RTX 4060 Ti at all). Cards
    // with no verified RunPod rate omit it and the UI hides that line.
    // vllmNote is shown next to the card only when vLLM is selected. The
    // CTA picks the first profile in this order that fits, so keep each
    // group sorted by VRAM, NVIDIA first.
    const PROFILES = [
      {
        group: 'Consumer NVIDIA',
        label: 'RTX 3060 12GB', vramGb: 12, amazonQuery: 'RTX 3060 12GB',
        runpodEquivalent: { name: 'RTX 3080 Ti', hourlyRate: 0.18 },
      },
      {
        group: 'Consumer NVIDIA',
        label: 'RTX 4060 Ti 16GB', vramGb: 16, amazonQuery: 'RTX 4060 Ti 16GB',
        runpodEquivalent: { name: 'RTX 4080 SUPER', hourlyRate: 0.28 },
      },
      {
        group: 'Consumer NVIDIA',
        label: 'RTX 3090 / 4090 24GB', vramGb: 24, amazonQuery: 'RTX 4090 24GB',
        runpodEquivalent: { name: 'RTX 4090', hourlyRate: 0.34 },
      },
      {
        group: 'Consumer NVIDIA',
        label: 'RTX 5090 32GB', vramGb: 32, amazonQuery: 'RTX 5090 32GB',
      },
      {
        group: 'Consumer AMD & Intel',
        label: 'Intel Arc A770 16GB', vramGb: 16, amazonQuery: 'Intel Arc A770 16GB',
        vllmNote: 'Intel support is basic and has no prebuilt wheels',
      },
      {
        group: 'Consumer AMD & Intel',
        label: 'AMD RX 7900 XTX 24GB', vramGb: 24, amazonQuery: 'RX 7900 XTX 24GB',
        vllmNote: 'needs ROCm 6.3 or newer',
      },
    ];

    const GB = 1024 ** 3;
    const MAX_LOG_ENTRIES = 8;

    // Mirror of src/lib/engine-math.ts — keep in sync.
    const VLLM_BLOCK_TOKENS = 16;
    const VLLM_GPU_UTILIZATION = 0.9;
    const OVERHEAD_FRACTION = 0.1;
    // Fit status: system RAM left for the OS when estimating CPU offload.
    const OS_RESERVED_RAM_GB = 4;

    const ENGINE_NOTES = {
      llamacpp:
        'llama.cpp reserves the KV cache for the full context when the model loads, so out-of-memory errors show up at startup. Extra server slots share the same context and add no memory.',
      vllm:
        'vLLM reserves 90% of VRAM by default and allocates KV in 16-token blocks, so your GPU needs the total divided by 0.90. Overhead reuses the 10% estimate. vLLM usually serves safetensors (AWQ, GPTQ, FP8), not GGUF, so weight size is a GGUF-based estimate.',
    };

    function engineEstimate(weightBytes, arch, context, engine) {
      let kvBytes;
      let gpuMultiplier = 1;
      if (engine === 'vllm') {
        const rounded = Math.ceil(context / VLLM_BLOCK_TOKENS) * VLLM_BLOCK_TOKENS;
        kvBytes = kvBytesFor(arch, rounded);
        gpuMultiplier = 1 / VLLM_GPU_UTILIZATION;
      } else {
        kvBytes = kvBytesFor(arch, context);
      }
      const overheadBytes = (weightBytes + kvBytes) * OVERHEAD_FRACTION;
      const totalBytes = weightBytes + kvBytes + overheadBytes;
      return {
        kvBytes: kvBytes,
        overheadBytes: overheadBytes,
        totalBytes: totalBytes,
        requiredGpuBytes: totalBytes * gpuMultiplier,
      };
    }

    const root = document.getElementById('vram-calculator');
    // Affiliate tag comes from src/lib/affiliate.ts via a data attribute,
    // so it is never hardcoded in this script.
    const AMAZON_TAG = (root && root.dataset.amazonTag) || '';

    let ingestedModels = [];
    try {
      const raw = document.getElementById('models-data').textContent;
      ingestedModels = raw ? JSON.parse(raw) : [];
    } catch {
      ingestedModels = [];
    }

    const sourceSelect = document.getElementById('model-source');
    const genericSizeRow = document.getElementById('generic-model-size-row');
    const genericQuantRow = document.getElementById('generic-quant-row');
    const modelQuantRow = document.getElementById('model-quant-row');
    const modelQuantSelect = document.getElementById('model-quant');
    const modelMatchNote = document.getElementById('model-match-note');

    const modelSlider = document.getElementById('model-size');
    const modelLabel = document.getElementById('model-size-label');
    const contextSlider = document.getElementById('context');
    const contextLabel = document.getElementById('context-label');
    const contextNote = document.getElementById('context-note');
    const quantSelect = document.getElementById('quant');
    const gpuQtySelect = document.getElementById('gpu-qty');
    const gpuQtyNote = document.getElementById('gpu-qty-note');
    const gpuVramSelect = document.getElementById('gpu-vram');
    const systemRamSelect = document.getElementById('system-ram');
    const engineNote = document.getElementById('engine-note');
    const engineRadios = document.querySelectorAll('input[name="engine"]');
    const outRequiredLabel = document.getElementById('out-required-label');
    const outRequired = document.getElementById('out-required');
    const fitStatusEls = [
      document.getElementById('fit-status'),
      document.getElementById('fit-status-modal'),
    ];

    const outWeights = document.getElementById('out-weights');
    const outKv = document.getElementById('out-kv');
    const outOverhead = document.getElementById('out-overhead');
    const outTotal = document.getElementById('out-total');
    const outProfiles = document.getElementById('out-profiles');

    const changeLog = document.getElementById('change-log');
    const changeLogEmpty = document.getElementById('change-log-empty');
    const logEntries = [];

    function currentEngine() {
      const checked = document.querySelector('input[name="engine"]:checked');
      return checked ? checked.value : 'llamacpp';
    }

    // Three-tier fit status. Returns null until a GPU VRAM size is chosen.
    function computeFitStatus(totalGb, requiredGpuGb, engine, qty) {
      const vramPerCard = Number(gpuVramSelect.value);
      if (!vramPerCard) return null;
      const pooledGb = vramPerCard * qty;
      const ramGb = Number(systemRamSelect.value);

      if (requiredGpuGb <= pooledGb) {
        return {
          tier: 'full',
          title: 'Full GPU fit',
          text:
            'Weights and KV cache fit entirely in your ' + pooledGb + ' GB of VRAM' +
            (engine === 'vllm' ? ' (after the 90% vLLM reservation).' : '.'),
        };
      }

      if (!ramGb) {
        return {
          tier: 'unknown',
          title: 'Does not fit in GPU VRAM',
          text: 'Set your system RAM to check whether CPU offload could work.',
        };
      }

      const gpuUsableGb = engine === 'vllm' ? pooledGb * VLLM_GPU_UTILIZATION : pooledGb;
      const usableRamGb = Math.max(0, ramGb - OS_RESERVED_RAM_GB);
      if (totalGb <= gpuUsableGb + usableRamGb) {
        return {
          tier: 'offload',
          title: 'Offload required',
          text:
            'Needs about ' + totalGb.toFixed(1) + ' GB, more than your GPU can hold. Part of the model would run from system RAM, which reduces token generation speed.' +
            (engine === 'vllm' ? ' llama.cpp is usually the better engine for partial CPU offload.' : ''),
        };
      }

      return {
        tier: 'oom',
        title: 'Out of memory',
        text:
          'Needs about ' + totalGb.toFixed(1) + ' GB, more than your GPU VRAM plus usable system RAM (' +
          (gpuUsableGb + usableRamGb).toFixed(1) + ' GB). Use a smaller quantization, shorten the context, or add memory.',
      };
    }

    function renderFitStatus(status) {
      const styles = {
        full: 'border-accent-tertiary text-accent-tertiary',
        offload: 'border-accent-secondary text-accent-secondary',
        oom: 'border-accent-error text-accent-error',
        unknown: 'border-border text-secondary',
      };
      fitStatusEls.forEach(function (el) {
        if (!el) return;
        if (!status) {
          el.classList.add('hidden');
          el.innerHTML = '';
          return;
        }
        el.className = 'mt-sm text-body-md rounded-md border p-sm ' + styles[status.tier];
        el.innerHTML = '';
        const title = document.createElement('p');
        title.className = 'font-bold m-0';
        title.textContent = status.title;
        const text = document.createElement('p');
        text.className = 'm-0 mt-xs';
        text.textContent = status.text;
        el.appendChild(title);
        el.appendChild(text);
      });
    }

    function formatGb(bytes) {
      return (bytes / GB).toFixed(2) + ' GB';
    }

    function formatContext(tokens) {
      return Math.round(tokens / 1024) + 'K';
    }

    function parseParamsB(title) {
      const match = title.match(/(\d+(?:\.\d+)?)\s?B/i);
      return match ? parseFloat(match[1]) : null;
    }

    function nearestBucket(paramsB, modelName) {
      if (paramsB == null) return null;
      if (modelName && MOE_NAME_PATTERN.test(modelName)) return null;
      let closest = MODEL_SIZES[0];
      let closestDiff = Infinity;
      for (const bucket of MODEL_SIZES) {
        const diff = Math.abs(bucket.params / 1e9 - paramsB);
        if (diff < closestDiff) {
          closestDiff = diff;
          closest = bucket;
        }
      }
      if (closestDiff > BUCKET_DISTANCE_CAP_B) return null;
      return closest;
    }

    function bucketToArch(bucket) {
      if (!bucket) return null;
      return {
        label: bucket.label,
        kvGroups: [{ layers: bucket.layers, kvHeads: bucket.kvHeads, headDim: bucket.headDim }],
      };
    }

    function archForModel(model) {
      if (model.arch) return model.arch;
      return bucketToArch(nearestBucket(parseParamsB(model.title), model.title));
    }

    function kvBytesFor(arch, context) {
      return arch.kvGroups.reduce(function (sum, g) {
        return sum + 2 * g.layers * g.kvHeads * g.headDim * Math.min(context, g.window || context) * 2;
      }, 0);
    }

    function populateModelQuantOptions(model) {
      modelQuantSelect.innerHTML = '';
      model.quantizations.forEach((q, i) => {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = `${q.type} (${q.size_gb.toFixed(2)} GB exact)`;
        modelQuantSelect.appendChild(opt);
      });

      const syncedDate = model.lastSynced ? model.lastSynced.slice(0, 10) : 'unknown date';
      const arch = archForModel(model);

      if (model.arch) {
        modelMatchNote.textContent =
          `KV cache computed from this model's published attention config (${model.arch.label}). ` +
          (model.arch.note ? model.arch.note + ' ' : '') +
          `Weights synced ${syncedDate}.`;
      } else if (arch) {
        modelMatchNote.textContent =
          `KV cache estimated using the ${arch.label} reference architecture ` +
          `(matched from "${parseParamsB(model.title)}B" in the model name). Weights synced ${syncedDate}.`;
      } else {
        modelMatchNote.textContent =
          `No total VRAM estimate for this model: it is a mixture-of-experts model, ` +
          `has no parameter count in its name, or is more than ${BUCKET_DISTANCE_CAP_B}B parameters ` +
          `from every reference architecture, and no published attention config is recorded for it. ` +
          `Weights (exact) synced ${syncedDate}.`;
      }
    }

    function updateSourceVisibility() {
      const isGeneric = sourceSelect.value === 'generic';
      // genericSizeRow also wraps the quantization, context and engine
      // controls (its closing tag is missing in the markup, and closing
      // it would change the page layout), so hide only its own first
      // three children: label, slider, tick labels.
      Array.from(genericSizeRow.children).slice(0, 3).forEach((el) => el.classList.toggle('hidden', !isGeneric));
      genericQuantRow.classList.toggle('hidden', !isGeneric);
      modelQuantRow.classList.toggle('hidden', isGeneric);

      if (!isGeneric) {
        const index = Number(sourceSelect.value.split(':')[1]);
        const model = ingestedModels[index];
        if (model) populateModelQuantOptions(model);
      }
    }

    function setCtaVisibility(showCloud, showLocal) {
      const cloudCta = document.getElementById('cloud-fallback-cta');
      const localCta = document.getElementById('local-hardware-cta');
      if (cloudCta) cloudCta.classList.toggle('hidden', !showCloud);
      if (localCta) localCta.classList.toggle('hidden', !showLocal);
    }

    function showNoEstimate(weightBytes) {
      outWeights.textContent = formatGb(weightBytes);
      outKv.textContent = '—';
      outOverhead.textContent = '—';
      outTotal.textContent = '—';
      outRequiredLabel.classList.add('hidden');
      outRequired.classList.add('hidden');
      renderFitStatus(null);
      outProfiles.innerHTML = '';
      const li = document.createElement('li');
      li.className = 'text-body-md text-secondary';
      li.textContent = 'No total estimate for this model — see the note under the quantization dropdown.';
      outProfiles.appendChild(li);
      setCtaVisibility(false, false);
    }

    function compute() {
      const context = CONTEXT_LENGTHS[Number(contextSlider.value)];
      contextLabel.textContent = context.toLocaleString();
      contextSlider.setAttribute('aria-valuetext', context.toLocaleString() + ' tokens');

      const qty = Number(gpuQtySelect.value) || 1;
      gpuQtyNote.classList.toggle('hidden', qty === 1);

      let weightBytes;
      let arch;
      let maxContext = null;

      if (sourceSelect.value === 'generic') {
        const model = MODEL_SIZES[Number(modelSlider.value)];
        const bpw = Number(quantSelect.value);
        modelLabel.textContent = model.label;
        modelSlider.setAttribute('aria-valuetext', model.label);

        weightBytes = model.params * (bpw / 8);
        arch = bucketToArch(model);
      } else {
        const index = Number(sourceSelect.value.split(':')[1]);
        const model = ingestedModels[index];
        if (!model || model.quantizations.length === 0) return;

        const quantIndex = Number(modelQuantSelect.value || 0);
        const quant = model.quantizations[quantIndex];
        weightBytes = quant.size_gb * GB;

        arch = archForModel(model);
        if (model.arch && model.arch.maxContext) maxContext = model.arch.maxContext;
      }

      if (maxContext && context > maxContext) {
        contextNote.textContent =
          `This model's native context is ${formatContext(maxContext)}. ` +
          `${formatContext(context)} is beyond it and would need RoPE/YaRN extension.`;
        contextNote.classList.remove('hidden');
      } else {
        contextNote.classList.add('hidden');
      }

      if (!arch) {
        showNoEstimate(weightBytes);
        return;
      }

      const engine = currentEngine();
      engineNote.textContent = ENGINE_NOTES[engine];
      const est = engineEstimate(weightBytes, arch, context, engine);

      outWeights.textContent = formatGb(weightBytes);
      outKv.textContent = formatGb(est.kvBytes);
      outOverhead.textContent = formatGb(est.overheadBytes);
      outTotal.textContent = formatGb(est.totalBytes);

      const isVllm = engine === 'vllm';
      outRequiredLabel.classList.toggle('hidden', !isVllm);
      outRequired.classList.toggle('hidden', !isVllm);
      outRequired.textContent = formatGb(est.requiredGpuBytes);

      const totalGb = est.totalBytes / GB;
      // What the GPU itself must provide: higher than the total for vLLM
      // because of its 0.90 utilization ceiling.
      const neededGb = est.requiredGpuBytes / GB;

      renderFitStatus(computeFitStatus(totalGb, neededGb, engine, qty));

      outProfiles.innerHTML = '';
      let lastGroup = null;
      PROFILES.forEach((profile) => {
        if (profile.group !== lastGroup) {
          lastGroup = profile.group;
          const header = document.createElement('li');
          header.className = 'text-body-md text-primary font-bold mt-xs';
          header.textContent = profile.group;
          outProfiles.appendChild(header);
        }
        const pooledGb = profile.vramGb * qty;
        const fits = neededGb <= pooledGb;
        const li = document.createElement('li');
        li.className =
          'flex flex-wrap items-center gap-xs text-body-md ' +
          (fits ? 'text-accent-tertiary' : 'text-accent-error');
        const name = qty > 1 ? qty + '× ' + profile.label + ' (' + pooledGb + ' GB pooled)' : profile.label;
        li.innerHTML =
          '<span aria-hidden="true">' + (fits ? '✓' : '✗') + '</span>' +
          '<span>' + name + '</span>';
        if (engine === 'vllm' && profile.vllmNote) {
          const note = document.createElement('span');
          note.className = 'text-secondary';
          note.textContent = '(vLLM: ' + profile.vllmNote + ')';
          li.appendChild(note);
        }
        outProfiles.appendChild(li);
      });

      const bestFit = PROFILES.find((p) => neededGb <= p.vramGb * qty) || null;
      setCtaVisibility(!bestFit, !!bestFit);

      if (bestFit) {
        const pooledGb = bestFit.vramGb * qty;
        const cardNameEl = document.getElementById('local-cta-card-name');
        const descEl = document.getElementById('local-cta-desc');
        const btnEl = document.getElementById('outbound-amazon');
        const btnTextEl = document.getElementById('local-cta-btn-text');
        const blurbEl = document.getElementById('local-cta-blurb');
        const runpodBox = document.getElementById('local-cta-runpod-budget');
        const runpodBtnEl = document.getElementById('outbound-runpod-budget');
        const runpodTextEl = document.getElementById('local-cta-runpod-text');

        const displayName = qty > 1 ? qty + '× ' + bestFit.label : bestFit.label;

        if (cardNameEl) cardNameEl.textContent = displayName;
        if (descEl) {
          descEl.textContent =
            qty > 1
              ? `This configuration fits on ${qty} of these cards (${pooledGb} GB pooled) — you would need to buy ${qty}. ` +
                `Pooled VRAM is an upper bound; see the multi-GPU note above.`
              : `This configuration fits on a single ${bestFit.label} card ` +
                `(the lowest-VRAM card in the list above that has enough VRAM).`;
        }
        if (btnTextEl) {
          btnTextEl.textContent =
            qty > 1
              ? `Check current live pricing on Amazon for ${bestFit.amazonQuery} × ${qty}`
              : `Check current live pricing on Amazon for ${bestFit.amazonQuery}`;
        }
        if (btnEl) {
          btnEl.href =
            'https://www.amazon.com/s?k=' +
            encodeURIComponent(bestFit.amazonQuery) +
            (AMAZON_TAG ? '&tag=' + encodeURIComponent(AMAZON_TAG) : '');
        }
        if (blurbEl) {
          blurbEl.textContent = `Opens an Amazon search for the ${bestFit.amazonQuery}. Prices and stock change daily.`;
        }

        if (runpodBox && bestFit.runpodEquivalent) {
          runpodBox.classList.remove('hidden');
          const eq = bestFit.runpodEquivalent;
          const hourly = (eq.hourlyRate * qty).toFixed(2);
          const eqName = qty > 1 ? qty + '× ' + eq.name : eq.name;
          if (runpodTextEl) {
            runpodTextEl.textContent =
              `Deploy closest cloud equivalent (${eqName}) instantly on RunPod for ~$${hourly}/hr`;
          }
          if (runpodBtnEl) runpodBtnEl.setAttribute('aria-label', runpodTextEl ? runpodTextEl.textContent : '');
        } else if (runpodBox) {
          runpodBox.classList.add('hidden');
        }
      }
    }

    function logChange(message) {
      logEntries.unshift(`${message} → Total: ${outTotal.textContent}`);
      if (logEntries.length > MAX_LOG_ENTRIES) logEntries.length = MAX_LOG_ENTRIES;

      changeLog.innerHTML = '';
      logEntries.forEach((entry) => {
        const li = document.createElement('li');
        li.textContent = entry;
        changeLog.appendChild(li);
      });
      if (logEntries.length === 0) {
        changeLog.appendChild(changeLogEmpty);
      }
    }

    sourceSelect.addEventListener('change', () => {
      updateSourceVisibility();
      compute();
      logChange('Source → ' + sourceSelect.options[sourceSelect.selectedIndex].text);
    });

    modelSlider.addEventListener('input', compute);
    modelSlider.addEventListener('change', () => {
      logChange('Model size → ' + modelLabel.textContent);
    });

    contextSlider.addEventListener('input', compute);
    contextSlider.addEventListener('change', () => {
      logChange('Context → ' + contextLabel.textContent + ' tokens');
    });

    quantSelect.addEventListener('change', () => {
      compute();
      logChange('Quantization → ' + quantSelect.options[quantSelect.selectedIndex].text);
    });

    modelQuantSelect.addEventListener('change', () => {
      compute();
      logChange('Quantization → ' + modelQuantSelect.options[modelQuantSelect.selectedIndex].text);
    });

    gpuQtySelect.addEventListener('change', () => {
      compute();
      logChange('GPUs → ' + gpuQtySelect.value + '×');
    });

    engineRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        compute();
        logChange('Engine → ' + (currentEngine() === 'vllm' ? 'vLLM' : 'llama.cpp'));
      });
    });

    gpuVramSelect.addEventListener('change', compute);
    systemRamSelect.addEventListener('change', compute);

    // Dialog wiring. Escape-to-close and focus trapping are handled
    // natively by showModal() — nothing to write for those. Backdrop
    // click-to-close is NOT native behavior and is added here: a click
    // directly on the <dialog> element itself (not on anything inside
    // it) means the click landed on the backdrop area.
    const hardwareModal = document.getElementById('hardware-modal');
    const openBtn = document.getElementById('open-hardware-modal');
    const openTextBtn = document.getElementById('open-hardware-modal-text');
    const closeBtn = document.getElementById('close-hardware-modal');

    if (hardwareModal) {
      if (openBtn) openBtn.addEventListener('click', () => hardwareModal.showModal());
      if (openTextBtn) openTextBtn.addEventListener('click', () => hardwareModal.showModal());
      if (closeBtn) closeBtn.addEventListener('click', () => hardwareModal.close());
      hardwareModal.addEventListener('click', (e) => {
        if (e.target === hardwareModal) hardwareModal.close();
      });
    }

    updateSourceVisibility();
    compute();
  })();
</script>