---
import type { CollectionEntry } from 'astro:content';

// Sidebar for the docs. Each doc is its own page. On a doc page, the active doc
// opens to show its sections (anchor links on that page), and the section you
// are reading is highlighted by the page script.
interface Props {
  allDocs: CollectionEntry<'docs'>[];
  activeSlug?: string;
  sections?: { id: string; text: string }[];
}

const { allDocs, activeSlug, sections = [] } = Astro.props;
---

<nav
  id="docs-nav"
  aria-label="Documentation"
  class="docs-nav sticky border border-border rounded-md bg-surface p-sm"
>
  <p class="kicker px-sm pt-xs pb-sm m-0">Documentation</p>
  <ul class="list-none p-0 m-0 flex flex-col gap-[0.125rem]">
    {allDocs.map((doc) => {
      const isActive = doc.slug === activeSlug;
      return (
        <li>
          <a
            href={`/docs/${doc.slug}`}
            aria-current={isActive ? 'page' : undefined}
            class="docs-nav-link"
          >
            {doc.data.title}
          </a>
          {isActive && sections.length > 0 && (
            <ul class="docs-nav-sub">
              {sections.map((s) => (
                <li><a href={`#${s.id}`} data-sec={s.id}>{s.text}</a></li>
              ))}
            </ul>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<style is:global>
  .docs-nav{top:6rem;max-height:calc(100vh - 7rem);overflow-y:auto}
  .docs-nav-link{display:flex;align-items:center;min-height:2.75rem;padding:0 .75rem;border-left:3px solid transparent;border-radius:.4rem;color:var(--text-primary);font-weight:700;text-decoration:none;line-height:1.3}
  .docs-nav-link:hover,.docs-nav-link[aria-current="page"]{background:var(--brand-2-c);border-left-color:var(--brand-2)}
  .docs-nav-sub{list-style:none;margin:0 0 .4rem;padding:0 0 0 1rem;display:flex;flex-direction:column}
  .docs-nav-sub a{display:block;padding:.3rem .6rem;border-left:2px solid var(--border-color);color:var(--text-secondary);font-size:.88rem;line-height:1.35;text-decoration:none}
  .docs-nav-sub a:hover,.docs-nav-sub a[aria-current="true"]{color:var(--text-primary);border-left-color:var(--brand-3);font-weight:700}
</style>
