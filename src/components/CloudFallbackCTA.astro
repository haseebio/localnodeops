---
// Presentation layer only. This component has no knowledge of VRAM
// math and never influences it — src/lib/vram-math.ts and the client
// script in VramCalculator.astro remain 100% vendor-blind. Both cards
// below start hidden; VramCalculator.astro's compute() toggles exactly
// one of them visible based on whether the current estimate fits any
// local GPU profile — this file only renders markup.

import { RUNPOD_URL, LAMBDA_URL, AMAZON_RTX_4090_URL } from '../lib/affiliate';

interface Provider {
  name: string;
  url: string;
  blurb: string;
  cta: string;
  umamiEvent: string;
  primary: boolean;
}

// Button styles. Solid fill + charcoal text = 5.21:1 in both themes.
// The -container fill is always paired with text-primary (never
// on-primary): on-primary on the dark-theme container is only 1.92:1.
const BTN_BASE =
  'inline-flex items-center justify-center min-h-touch-min rounded-full border-2 border-accent-primary px-lg font-bold text-body-md text-center no-underline cursor-pointer transition-transform hover:-translate-y-[1px]';
const BTN_PRIMARY = `${BTN_BASE} bg-accent-primary-solid text-accent-on-primary`;
const BTN_SECONDARY = `${BTN_BASE} bg-accent-primary-container text-primary`;

// URLs (and their tagged defaults) live in src/lib/affiliate.ts.
const cloudProviders: Provider[] = [
  {
    name: 'RunPod',
    url: RUNPOD_URL,
    blurb: 'On-demand GPU pods, billed by the second.',
    cta: 'Deploy Instantly on RunPod',
    umamiEvent: 'outbound-runpod',
    primary: true,
  },
  {
    name: 'Lambda Labs',
    url: LAMBDA_URL,
    blurb: 'Reserved and on-demand cloud GPU instances.',
    cta: 'Rent GPUs on Lambda Labs',
    umamiEvent: 'outbound-lambda',
    primary: false,
  },
];

// Generic on purpose — VramCalculator.astro's compute() overwrites this
// text and href on load with the specific cheapest card that fits.
// This is only what a person would see for the instant before JS runs
// (or in the unlikely case JS fails), so it must never name a specific
// card — that mismatch is the exact bug this replaced.
const amazonProvider: Provider = {
  name: 'Amazon',
  url: AMAZON_RTX_4090_URL,
  blurb: 'Opens an Amazon search for a compatible GPU.',
  cta: 'Check GPU Pricing on Amazon',
  umamiEvent: 'outbound-amazon',
  primary: true,
};
---

<div id="cloud-fallback-cta"
  class="hidden border border-accent-secondary rounded-md bg-surface p-md mt-md"
>
  <p class="text-body-md text-primary font-bold m-0">This won't fit on local hardware</p>
  <p class="text-body-md text-secondary mt-xs mb-md">
    Based on the estimate above, this configuration exceeds every local GPU
    profile listed. Renting cloud GPU capacity is the practical option for
    a workload this size.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
    {cloudProviders.map((provider) => (
      <div class="flex flex-col border border-border rounded-md bg-surface p-md">
        <p class="text-headline-md text-primary m-0">{provider.name}</p>
        <p class="text-body-md text-secondary mt-xs mb-md flex-1">{provider.blurb}</p>
        <a href={provider.url}
          id={provider.umamiEvent}
          data-umami-event={provider.umamiEvent}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class={provider.primary ? BTN_PRIMARY : BTN_SECONDARY}
        >
          {provider.cta}
        </a>
      </div>
    ))}
  </div>

  <p class="text-body-md text-secondary mt-md border-t border-border pt-sm m-0">
    Disclosure: We may earn a commission from cloud providers if you spin
    up an instance through these links, at no extra cost to you. This
    never affects the VRAM math above — see
    <a href="/methodology" class="text-accent-primary hover:underline">/methodology</a>.
  </p>
</div>

<div id="local-hardware-cta"
  class="hidden border border-border rounded-md bg-surface p-md mt-md"
>
  <!--
    The card name and Amazon link are set dynamically by
    VramCalculator.astro's compute() on every recalculation — the text
    below is only a static fallback for the (extremely unlikely) case
    that JS fails to run. It must stay generic: hardcoding a specific
    card name here caused the exact bug this replaced (button always
    said "RTX 4090" regardless of what the calculator actually needed).
  -->
  <p class="text-body-md text-primary font-bold m-0">
    Fits on: <strong id="local-cta-card-name" class="text-accent-primary">a single local GPU</strong>
  </p>
  <p class="text-body-md text-secondary mt-xs mb-md" id="local-cta-desc">
    This configuration fits within the local GPU profiles above.
  </p>

  <a href={amazonProvider.url}
    id="outbound-amazon"
    data-umami-event="outbound-amazon"
    target="_blank"
    rel="noopener noreferrer sponsored"
    class={`${BTN_PRIMARY} w-full sm:w-auto`}
  >
    <span id="local-cta-btn-text">{amazonProvider.cta}</span>
  </a>
  <p class="text-body-md text-secondary mt-xs mb-0" id="local-cta-blurb">
    {amazonProvider.blurb} Prices and stock change daily.
  </p>

  <p class="text-body-md text-secondary mt-md border-t border-border pt-sm m-0">
    Disclosure: As an Amazon Associate, LocalNodeOps earns from qualifying
    purchases at no extra cost to you. This never affects the VRAM math
    above — see
    <a href="/methodology" class="text-accent-primary hover:underline">/methodology</a>.
  </p>
</div>