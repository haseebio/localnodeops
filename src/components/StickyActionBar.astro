---
import { RUNPOD_URL } from '../lib/affiliate';

// Primary: solid fill, charcoal text — 5.21:1 in both themes.
// Secondary: outline, text-primary — no fill, so no contrast pairing
// to verify beyond text-on-background (already 4.8+ everywhere on this site).
const BTN_PRIMARY =
  'flex-1 sm:flex-none sm:min-w-[190px] inline-flex items-center justify-center min-h-touch-min rounded-full px-lg font-semibold text-body-md text-center no-underline cursor-pointer bg-accent-primary-solid text-accent-on-primary transition-transform hover:-translate-y-[1px]';
const BTN_SECONDARY =
  'flex-1 sm:flex-none sm:min-w-[160px] inline-flex items-center justify-center min-h-touch-min rounded-full px-lg font-semibold text-body-md text-center no-underline cursor-pointer border-2 border-accent-primary text-primary bg-transparent transition-colors hover:bg-accent-primary-container';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex justify-center px-sm pb-sm sm:px-md sm:pb-md print:hidden pointer-events-none">
  <div
    id="sticky-action-bar"
    class="pointer-events-auto w-full max-w-2xl rounded-2xl border border-border bg-surface shadow-lg px-md py-xs"
  >
    <div class="flex gap-sm w-full">
      <a href="/calculator"
        data-umami-event="sticky-calculate-vram"
        class={BTN_SECONDARY}
      >
        Calculate VRAM
      </a>
      <a href={RUNPOD_URL}
        data-umami-event="sticky-runpod"
        target="_blank"
        rel="noopener noreferrer sponsored"
        class={BTN_PRIMARY}
      >
        Rent GPU on RunPod
      </a>
    </div>
    <p class="text-code-mono text-secondary text-center sm:text-left mt-[0.25rem] mb-0" style="font-size: 0.7rem;">
      RunPod partner link — we may earn a commission.
    </p>
  </div>
</div>

<!--
  Keeps the fixed bar from covering the end of the page (footer) and from
  hiding keyboard-focused elements. Global on purpose: it targets html/body.
  Only pages that render this component receive these rules.
-->
<style is:global>
  html {
    scroll-padding-bottom: 6rem;
  }
  body {
    padding-bottom: 6rem;
  }
</style>