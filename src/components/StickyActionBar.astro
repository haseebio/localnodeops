---
import { RUNPOD_URL } from '../lib/affiliate';

// Primary: solid fill, charcoal text — 5.21:1 in both themes.
// Secondary: outline, text-primary — no fill, so no contrast pairing
// to verify beyond text-on-background (already 4.8+ everywhere on this site).
const BTN_PRIMARY =
  'inline-flex items-center justify-center min-h-touch-min rounded-full px-lg font-semibold text-body-md text-center whitespace-nowrap no-underline cursor-pointer bg-accent-primary-solid text-accent-on-primary transition-transform hover:-translate-y-[1px]';
const BTN_SECONDARY =
  'inline-flex items-center justify-center min-h-touch-min rounded-full px-lg font-semibold text-body-md text-center whitespace-nowrap no-underline cursor-pointer border-2 border-accent-primary text-primary bg-transparent transition-colors hover:bg-accent-primary-container';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex justify-center px-sm pb-lg sm:pb-xl print:hidden pointer-events-none">
  <div
    id="sticky-action-bar"
    class="pointer-events-auto w-auto max-w-[90vw] rounded-2xl border border-border bg-surface shadow-lg px-md py-xs"
  >
    <div class="flex flex-wrap justify-center gap-sm">
      <a href="/calculator"
        data-umami-event="sticky-calculate-vram"
        class={BTN_SECONDARY}
      >
        Calculate VRAM
      </a>
      <a href={RUNPOD_URL}
        data-umami-event="sticky-runpod"
        target="_blank"
        rel="noopener noreferrer sponsored"
        class={BTN_PRIMARY}
      >
        Rent GPU on RunPod
      </a>
    </div>
    <p class="text-secondary text-[0.7rem] leading-[0.95rem] text-center mt-[0.25rem] mb-0">
      RunPod partner link — we may earn a commission.
    </p>
  </div>
</div>

<!--
  Keeps the fixed bar from covering the end of the page (footer) and from
  hiding keyboard-focused elements. Global on purpose: it targets html/body.
  Card's own footprint (buttons + padding + disclosure + its bottom
  offset) is roughly 110-115px — the previous 7rem (112px) body padding
  matched that almost exactly, leaving no real gap. 9rem gives ~30px of
  actual clearance instead of relying on the numbers lining up perfectly.
-->
<style is:global>
  html {
    scroll-padding-bottom: 9rem;
  }
  body {
    padding-bottom: 9rem;
  }
</style>