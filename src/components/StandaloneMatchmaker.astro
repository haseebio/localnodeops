  .mm-best{display:flex;flex-direction:column;gap:.3rem;margin:.25rem 0 .9rem;padding:.9rem 1rem;border:1px solid var(--border-color);border-left:4px solid var(--mm-full);border-radius:.75rem;background:var(--bg-surface-elevated)}
  .mm-best[hidden],.mm-saved[hidden]{display:none}
  .mm-saved{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin-bottom:.6rem;padding:.4rem .8rem;border:1px dashed var(--border-color);border-radius:.75rem;font-size:.9rem}
  .mm-tabs{position:sticky;top:4.6rem;z-index:5;background:var(--bg-base);padding:.35rem 0}
  @media (prefers-reduced-motion:reduce){.mm *{animation:none!important;transition:none!important}}
</style>
