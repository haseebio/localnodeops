  .mm-note{margin:.75rem 0 0;font-size:.85rem;line-height:1.5;color:var(--text-secondary)}
  .mm-list{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(16.5rem,1fr))}
