  .mm-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.25rem .75rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.8rem;color:var(--text-secondary)}
  .mm-params{margin:0;font-size:.8rem;color:var(--text-secondary)}
