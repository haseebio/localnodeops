  @media (hover:hover){.mm-chip:hover{background:var(--accent-primary-container)}}
  .mm-chip[aria-pressed="true"],.mm-chip-radio:has(.mm-radio:checked){background:var(--accent-primary-solid);border-color:var(--accent-primary-solid);color:var(--on-primary);font-weight:700}
  .mm-chip:disabled{opacity:.5;cursor:not-allowed}
