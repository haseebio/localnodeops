  .mm-chip-radio:has(.mm-radio:focus-visible),.mm-chip:focus-visible,.mm-tab:focus-visible,.mm-bar:focus-visible,.mm-range:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px}
  .mm-input{width:100%;min-height:2.75rem;margin-top:.4rem;padding:0 .8rem;border:1px solid var(--border-color);border-radius:.5rem;background:var(--bg-base);color:var(--text-primary);font-size:1rem}
  .mm-input-num{width:6rem;margin-top:0}
  .mm-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
  .mm-tab{display:flex;flex-direction:column;gap:.15rem;align-items:flex-start;min-height:3.5rem;padding:.55rem .8rem;border:1px solid var(--border-color);border-radius:.75rem;background:var(--bg-surface);color:var(--text-primary);cursor:pointer;text-align:left;transition:border-color .15s,background .15s}
  @media (hover:hover){.mm-tab:hover{background:var(--accent-primary-container)}}
  .mm-tab[aria-pressed="true"]{border-color:var(--accent-primary-solid);background:var(--accent-primary-container);box-shadow:inset 0 -3px 0 var(--accent-primary-solid)}
  .mm-count{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:1.5rem;font-weight:700;font-variant-numeric:tabular-nums;line-height:1}
  .mm-stack{display:flex;height:.5rem;margin-top:.6rem;border-radius:9999px;overflow:hidden;background:var(--border-subtle)}
