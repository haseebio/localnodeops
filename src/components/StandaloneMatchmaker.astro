---
import { getCollection } from 'astro:content';
import { getModelArch, nearestBucket, parseParamsB } from '../lib/vram-math';
import { estimateForEngine } from '../lib/engine-math';
import { usableQuants } from '../lib/quant-filter';
import { getModelRows } from '../lib/model-table';
import AffiliateOptions from './AffiliateOptions.astro';

// Context lengths offered by the toggle. 128K is 128 x 1024 tokens.
const CONTEXTS = [4096, 8192, 16384, 32768, 131072];
const CONTEXT_LABELS = ['4K', '8K', '16K', '32K', '128K'];
const VRAM_PRESETS = [8, 12, 16, 24, 32, 48, 80];
const RAM_PRESETS = [16, 32, 64, 128, 256];

// All memory math happens here, at build time, with the same shared
// functions the calculator pages use. The browser script below only
// compares these numbers with the VRAM and RAM the visitor picks, so there
// is no second copy of the formula to keep in sync.
const entries = await getCollection('models');
// Dense / MoE / Hybrid tag comes from the shared model table.
const typeBySlug = new Map((await getModelRows()).map((r) => [r.slug, r.type]));
let noEstimate = 0;
const models: {
  slug: string;
  title: string;
  paramsB: number | null;
  maxContext: number | null;
  type: string;
  quants: { type: string; sizeGb: number; totals: number[] }[];
}[] = [];

for (const entry of entries) {
  const arch =
    getModelArch(entry.slug) ?? nearestBucket(parseParamsB(entry.data.title), entry.data.title);
  // Keep only complete entries, so the helper always gets a type and a size.
  const complete = entry.data.quantizations.flatMap((q) =>
    typeof q.type === 'string' && typeof q.size_gb === 'number'
      ? [{ type: q.type, size_gb: q.size_gb }]
      : []
  );
  const quants = usableQuants(complete);
  if (!arch || quants.length === 0) {
    noEstimate++;
    continue;
  }
  models.push({
    slug: entry.slug,
    title: entry.data.title,
    paramsB: parseParamsB(entry.data.title),
    maxContext: arch.maxContext ?? null,
    type: typeBySlug.get(entry.slug) ?? 'Dense',
    quants: quants.map((q) => ({
      type: q.type,
      sizeGb: q.size_gb,
      totals: CONTEXTS.map((c) =>
        Number(estimateForEngine(q.size_gb, arch, c, 'llamacpp').totalGb.toFixed(3))
      ),
    })),
  });
}

const data = { contexts: CONTEXTS, labels: CONTEXT_LABELS, osReservedRamGb: 4, noEstimate, models };

const SAMPLES = [
  [8, 16],
  [16, 32],
  [24, 64],
  [48, 128],
];
---

<div id="matchmaker" class="mm">
  <div class="mm-grid">
    <aside id="mm-controls" class="mm-controls mm-panel" aria-label="Your hardware">
      <button type="button" id="mm-bar" class="mm-bar" aria-expanded="false" aria-controls="mm-controls-body">
        <span class="mm-kicker">Your hardware</span>
        <span class="mm-bar-main"><span id="mm-bar-text" class="mm-bar-text">24 GB VRAM · 32 GB RAM · 8K</span><span class="mm-bar-hint">Tap to adjust VRAM, RAM, context</span></span>
        <span class="mm-chevron" aria-hidden="true"></span>
      </button>

      <div id="mm-controls-body" class="mm-controls-body">
        <div class="mm-group">
          <span class="mm-kicker">Try a setup</span>
          <div class="mm-chips mm-samples-row" role="group" aria-label="Sample setups">
            {SAMPLES.map(([v, r]) => (
              <button type="button" class="mm-chip" data-sample={`${v},${r}`} aria-pressed="false">{v} GB + {r} GB RAM</button>
            ))}
          </div>
        </div>

        <div class="mm-group">
          <div class="mm-row-head">
            <label for="mm-vram" class="mm-kicker">GPU VRAM</label>
            <span class="mm-readout"><span id="mm-vram-label">24</span> GB</span>
          </div>
          <input id="mm-vram" type="range" min="4" max="128" step="1" value="24" class="mm-range" />
          <div class="mm-chips" role="group" aria-label="VRAM presets">
            {VRAM_PRESETS.map((v) => (
              <button type="button" class="mm-chip" data-preset="vram" data-value={v} aria-pressed="false">{v}</button>
            ))}
          </div>
        </div>

        <div class="mm-group">
          <div class="mm-row-head">
            <label for="mm-ram" class="mm-kicker">System RAM</label>
            <span class="mm-readout"><span id="mm-ram-label">32</span> GB</span>
          </div>
          <input id="mm-ram" type="range" min="8" max="256" step="1" value="32" class="mm-range" />
          <div class="mm-chips" role="group" aria-label="RAM presets">
            {RAM_PRESETS.map((v) => (
              <button type="button" class="mm-chip" data-preset="ram" data-value={v} aria-pressed="false">{v}</button>
            ))}
          </div>
        </div>

        <fieldset class="mm-group mm-fieldset">
          <legend class="mm-kicker">Context length</legend>
          <div class="mm-chips" role="radiogroup">
            {CONTEXT_LABELS.map((label, i) => (
              <label class="mm-chip mm-chip-radio">
                <input type="radio" name="mm-ctx" value={i} checked={i === 1} class="mm-radio" />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mm-group">
          <label for="mm-search" class="mm-kicker">Find a model</label>
          <input id="mm-search" type="search" placeholder="Search models, e.g. qwen" class="mm-input" />
        </div>

        <div class="mm-group">
          <span class="mm-kicker">Save and share</span>
          <div class="mm-chips">
            <button type="button" id="mm-copy-link" class="mm-chip">Copy link to this setup</button>
            <button type="button" id="mm-save-rig" class="mm-chip">Save my rig</button>
          </div>
          <p id="mm-share-status" class="mm-note" role="status"></p>
        </div>
      </div>
    </aside>

    <div class="mm-results">
      <div id="mm-saved" class="mm-saved" hidden>
        <span id="mm-saved-text"></span>
        <button type="button" id="mm-apply-rig" class="mm-chip">Apply</button>
      </div>
      <div id="mm-tabs" class="mm-tabs" role="group" aria-label="Filter by fit">
        <button type="button" class="mm-tab" data-tab="all" aria-pressed="true">
          <span class="mm-kicker">All</span><span class="mm-count" data-count="all">0</span>
        </button>
        <button type="button" class="mm-tab mm-t-full" data-tab="full" aria-pressed="false">
          <span class="mm-kicker">Full GPU fit</span><span class="mm-count" data-count="full">0</span>
        </button>
        <button type="button" class="mm-tab mm-t-offload" data-tab="offload" aria-pressed="false">
          <span class="mm-kicker">Offload required</span><span class="mm-count" data-count="offload">0</span>
        </button>
        <button type="button" class="mm-tab mm-t-none" data-tab="none" aria-pressed="false">
          <span class="mm-kicker">Out of memory</span><span class="mm-count" data-count="none">0</span>
        </button>
      </div>
      <div class="mm-stack" aria-hidden="true">
        <span class="mm-seg mm-t-full" data-seg="full"></span>
        <span class="mm-seg mm-t-offload" data-seg="offload"></span>
        <span class="mm-seg mm-t-none" data-seg="none"></span>
      </div>

      <p id="mm-summary" class="mm-summary" role="status"></p>
      <div id="mm-best" class="mm-best" hidden></div>
      <div id="mm-list" class="mm-list"></div>
      <p id="mm-note" class="mm-note"></p>
      <div id="mm-aff-over" hidden><AffiliateOptions state="over" /></div>
      <div id="mm-aff-fit" hidden><AffiliateOptions state="fit" /></div>
    </div>
  </div>

  <section id="mm-multi" class="mm-panel mm-multi">
    <h2 class="mm-multi-title">Run more than one model at once</h2>
    <p class="mm-note">
      Pick up to three models. Their memory is added together at the context length above, then
      compared with your VRAM and RAM.
    </p>
    <div id="mm-multi-rows" class="mm-multi-rows"></div>
    <div class="mm-multi-tools">
      <button type="button" id="mm-multi-add" class="mm-chip">Add a model</button>
      <label for="mm-multi-extra" class="mm-kicker">Other memory in use (GB)</label>
      <input id="mm-multi-extra" type="number" min="0" max="512" step="0.5" value="0" class="mm-input mm-input-num" />
    </div>
    <p id="mm-multi-result" class="mm-summary" role="status"></p>
    <span id="mm-multi-badge" class="hidden"></span>
    <p id="mm-multi-note" class="mm-note"></p>
  </section>
</div>

<script is:inline type="application/json" id="mm-data" set:html={JSON.stringify(data)} />

<script is:inline>
  (function () {
    const root = document.getElementById('matchmaker');
    if (!root) return;
    const data = JSON.parse(document.getElementById('mm-data').textContent);

    const vramInput = document.getElementById('mm-vram');
    const ramInput = document.getElementById('mm-ram');
    const vramLabel = document.getElementById('mm-vram-label');
    const ramLabel = document.getElementById('mm-ram-label');
    const searchInput = document.getElementById('mm-search');
    const summary = document.getElementById('mm-summary');
    const list = document.getElementById('mm-list');
    const note = document.getElementById('mm-note');
    const tabButtons = Array.prototype.slice.call(document.querySelectorAll('#mm-tabs [data-tab]'));
    const bar = document.getElementById('mm-bar');
    const controls = document.getElementById('mm-controls');
    const barText = document.getElementById('mm-bar-text');
    const countEls = Array.prototype.slice.call(root.querySelectorAll('[data-count]'));
    const presetBtns = Array.prototype.slice.call(root.querySelectorAll('[data-preset]'));
    const segEls = {
      full: root.querySelector('[data-seg="full"]'),
      offload: root.querySelector('[data-seg="offload"]'),
      none: root.querySelector('[data-seg="none"]'),
    };

    const TIGHT_RATIO = 0.95; // 95% or more of VRAM is marked "very tight"
    const BADGE = {
      full: { text: 'Full GPU fit', cls: 'mm-t-full' },
      offload: { text: 'Offload required', cls: 'mm-t-offload' },
      none: { text: 'Out of memory', cls: 'mm-t-none' },
    };

    const state = { tab: 'all' };
    const bestEl = document.getElementById('mm-best');
    const savedEl = document.getElementById('mm-saved');
    const savedText = document.getElementById('mm-saved-text');
    const affOver = document.getElementById('mm-aff-over');
    const affFit = document.getElementById('mm-aff-fit');
    const shareStatus = document.getElementById('mm-share-status');
    const RIG_KEY = 'lno-saved-rig';
    let rig = null; // saved on this device only (localStorage), never sent anywhere
    try {
      const raw = window.localStorage.getItem(RIG_KEY);
      if (raw) rig = JSON.parse(raw);
    } catch (e) { rig = null; }

    const multiRowsEl = document.getElementById('mm-multi-rows');
    const multiAdd = document.getElementById('mm-multi-add');
    const multiExtra = document.getElementById('mm-multi-extra');
    const multiResult = document.getElementById('mm-multi-result');
    const multiBadge = document.getElementById('mm-multi-badge');
    const multiNote = document.getElementById('mm-multi-note');
    const MULTI_MAX = 3;
    const MULTI_SELECT_CLASS = 'mm-select';
    const multiRows = []; // { row, modelSel, quantSel }

    function ctxIndex() {
      const checked = document.querySelector('input[name="mm-ctx"]:checked');
      return checked ? Number(checked.value) : 1;
    }

    // Largest usable quantization that fits fully in VRAM. If none does, the
    // smallest one decides the tier. Totals come precomputed from the shared
    // build-time math, so this only compares numbers.
    function pick(model, ci, vram, ram) {
      const quants = model.quants.slice().sort(function (a, b) { return b.sizeGb - a.sizeGb; });
      for (let i = 0; i < quants.length; i++) {
        if (quants[i].totals[ci] <= vram) {
          return { tier: 'full', quant: quants[i], total: quants[i].totals[ci] };
        }
      }
      const smallest = quants[quants.length - 1];
      const usableRam = Math.max(0, ram - data.osReservedRamGb);
      const total = smallest.totals[ci];
      return { tier: total <= vram + usableRam ? 'offload' : 'none', quant: smallest, total: total };
    }

    // Full-precision files are synced with long path-like names, for example
    // "BF16/Model-BF16". Show just the format. Clean names (Q6_K_L, Q8_0-F16)
    // are left as they are.
    function shortQuant(type) {
      const last = String(type).split('/').pop();
      if (/^I?Q\d[A-Za-z0-9_-]*$/i.test(last)) return last;
      const full = last.match(/(bf16|f16|f32|fp16|fp32)$/i);
      if (full) return full[1].toUpperCase();
      const tail = last.match(/-([A-Za-z0-9_]+)$/);
      return tail ? tail[1] : last;
    }

    function makeCard(item, vram) {
      const tierNow = item.pick.tier;
      const tier = item.pick.tier;
      const card = document.createElement('div');
      card.className = 'mm-card ' + BADGE[tier].cls;

      const title = document.createElement('a');
      title.href = '/calculator/' + encodeURIComponent(item.model.slug);
      title.className = 'mm-title';
      title.textContent = item.model.title;

      const badge = document.createElement('span');
      badge.className = 'mm-badge ' + BADGE[tier].cls;
      badge.textContent =
        BADGE[tier].text + (tier === 'full' && item.pick.total / vram >= TIGHT_RATIO ? ' (very tight)' : '');

      const top = document.createElement('div');
      top.className = 'mm-card-top';
      const typeTag = document.createElement('span');
      typeTag.className = 'mm-tag';
      typeTag.textContent = item.model.type;
      top.appendChild(badge);
      top.appendChild(typeTag);

      const gauge = document.createElement('div');
      gauge.className = 'mm-gauge';
      gauge.setAttribute('role', 'img');
      gauge.setAttribute(
        'aria-label',
        'Needs ' + item.pick.total.toFixed(1) + ' GB of ' + vram + ' GB of VRAM'
      );
      const fill = document.createElement('span');
      fill.className = 'mm-gauge-fill';
      fill.style.width = Math.min(100, (item.pick.total / vram) * 100).toFixed(1) + '%';
      gauge.appendChild(fill);

      const meta = document.createElement('div');
      meta.className = 'mm-meta';
      const file = document.createElement('span');
      file.textContent = 'GGUF ' + shortQuant(item.pick.quant.type) + ' · ' + item.pick.quant.sizeGb.toFixed(1) + ' GB';
      const need = document.createElement('span');
      need.textContent = 'Needs ' + item.pick.total.toFixed(1) + ' GB';
      meta.appendChild(file);
      meta.appendChild(need);

      const params = document.createElement('p');
      params.className = 'mm-params';
      params.textContent = item.model.paramsB
        ? 'About ' + item.model.paramsB + 'B parameters (read from the model name)'
        : 'Parameter count is not in the model name';

      card.appendChild(title);
      card.appendChild(top);
      card.appendChild(gauge);
      card.appendChild(meta);
      card.appendChild(params);
      if (rig && rig.vram && rig.vram !== vram && item.pick.total > rig.vram) {
        const warn = document.createElement('p');
        warn.className = 'mm-warn';
        warn.textContent = 'Needs ' + item.pick.total.toFixed(1) + ' GB; your saved rig has ' + rig.vram + ' GB of VRAM.';
        card.appendChild(warn);
      }
      const calc = document.createElement('a');
      calc.href = '/calculator/' + encodeURIComponent(item.model.slug);
      calc.className = 'mm-calc-link';
      calc.textContent = 'Check in calculator \u2192';
      card.appendChild(calc);
      return card;
    }

    // "Run more than one model at once". Each quantization already carries its
    // memory total (weights + KV cache + 10%) for every context length, so the
    // sum is plain addition of build-time numbers.
    function sortedQuants(model) {
      return model.quants.slice().sort(function (a, b) { return b.sizeGb - a.sizeGb; });
    }

    function multiName(model) {
      return model.title.replace(/-GGUF$/i, '');
    }

    function defaultQuantIndex(list) {
      for (let i = 0; i < list.length; i++) {
        if (/^Q4_K_M$/i.test(shortQuant(list[i].type))) return i;
      }
      return Math.floor(list.length / 2);
    }

    function addRow(modelIndex) {
      if (multiRows.length >= MULTI_MAX) return;
      const row = document.createElement('div');
      row.className = '';

      const modelSel = document.createElement('select');
      modelSel.className = MULTI_SELECT_CLASS;
      modelSel.setAttribute('aria-label', 'Model');
      data.models.forEach(function (m, i) {
        const o = document.createElement('option');
        o.value = String(i);
        o.textContent = multiName(m);
        modelSel.appendChild(o);
      });
      modelSel.value = String(modelIndex);

      const quantSel = document.createElement('select');
      quantSel.className = MULTI_SELECT_CLASS;
      quantSel.setAttribute('aria-label', 'Quantization');

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'mm-chip';
      remove.textContent = 'Remove';

      const entry = { row: row, modelSel: modelSel, quantSel: quantSel };

      function fillQuants() {
        quantSel.replaceChildren();
        const list = sortedQuants(data.models[Number(modelSel.value)]);
        list.forEach(function (q, i) {
          const o = document.createElement('option');
          o.value = String(i);
          o.textContent = shortQuant(q.type) + ', ' + q.sizeGb.toFixed(1) + ' GB';
          quantSel.appendChild(o);
        });
        quantSel.value = String(defaultQuantIndex(list));
      }

      modelSel.addEventListener('change', function () {
        fillQuants();
        renderMulti();
      });
      quantSel.addEventListener('change', renderMulti);
      remove.addEventListener('click', function () {
        multiRows.splice(multiRows.indexOf(entry), 1);
        multiRowsEl.removeChild(row);
        renderMulti();
      });

      row.appendChild(modelSel);
      row.appendChild(quantSel);
      row.appendChild(remove);
      fillQuants();
      multiRows.push(entry);
      multiRowsEl.appendChild(row);
      renderMulti();
    }

    function renderMulti() {
      const vram = Number(vramInput.value);
      const ram = Number(ramInput.value);
      const ci = ctxIndex();
      multiAdd.disabled = multiRows.length >= MULTI_MAX;

      const labels = [];
      const warnings = [];
      let sum = 0;
      multiRows.forEach(function (entry) {
        const model = data.models[Number(entry.modelSel.value)];
        const q = sortedQuants(model)[Number(entry.quantSel.value)];
        const gb = q.totals[ci];
        labels.push(multiName(model) + ' ' + shortQuant(q.type) + ' ' + gb.toFixed(1) + ' GB');
        sum += gb;
        if (model.maxContext && data.contexts[ci] > model.maxContext) warnings.push(multiName(model));
      });
      const extra = Math.max(0, Number(multiExtra.value) || 0);
      if (extra > 0) {
        labels.push('other ' + extra.toFixed(1) + ' GB');
        sum += extra;
      }

      let note =
        'Memory only. Models running together share the GPU, so each one runs slower. Embedding and speech models are not in the synced list: enter their memory in "Other memory in use". It is added as entered, without the 10% overhead.';
      if (warnings.length > 0) note += ' Beyond native context: ' + warnings.join(', ') + '.';
      if (data.contexts[ci] > 32768) {
        note += ' Native context limits are known for only some models, so check each model before relying on this.';
      }
      multiNote.textContent = note;

      if (labels.length === 0) {
        multiResult.textContent = 'Add a model to see the combined memory.';
        multiBadge.className = 'hidden';
        return;
      }

      const usableRam = Math.max(0, ram - data.osReservedRamGb);
      const tier = sum <= vram ? 'full' : sum <= vram + usableRam ? 'offload' : 'none';
      const sentence =
        tier === 'full'
          ? 'About ' + Math.max(0, vram - sum).toFixed(1) + ' GB of VRAM stays free.'
          : tier === 'offload'
            ? 'About ' + (sum - vram).toFixed(1) + ' GB would run from system RAM, which is slower.'
            : 'This does not fit in VRAM plus usable system RAM.';
      multiResult.textContent = 'Combined memory: ' + labels.join(' + ') + ' = ' + sum.toFixed(1) + ' GB. ' + sentence;
      const b = BADGE[tier];
      multiBadge.className = 'mm-badge ' + b.cls;
      multiBadge.textContent = b.text + (tier === 'full' && sum / vram >= TIGHT_RATIO ? ' (very tight)' : '');
    }

    function render() {
      const vram = Number(vramInput.value);
      const ram = Number(ramInput.value);
      const ci = ctxIndex();
      vramLabel.textContent = String(vram);
      ramLabel.textContent = String(ram);

      const items = [];
      let beyondContext = 0;
      data.models.forEach(function (model) {
        if (model.maxContext && data.contexts[ci] > model.maxContext) {
          beyondContext++;
          return;
        }
        items.push({ model: model, pick: pick(model, ci, vram, ram) });
      });

      const counts = { full: 0, offload: 0, none: 0 };
      items.forEach(function (it) { counts[it.pick.tier]++; });

      countEls.forEach(function (el) {
        const k = el.getAttribute('data-count');
        el.textContent = String(k === 'all' ? items.length : counts[k]);
      });
      ['full', 'offload', 'none'].forEach(function (k) {
        segEls[k].style.flexGrow = String(counts[k]);
      });
      barText.textContent = vram + ' GB VRAM · ' + ram + ' GB RAM · ' + data.labels[ci];
      presetBtns.forEach(function (b) {
        const target = b.getAttribute('data-preset') === 'vram' ? vram : ram;
        b.setAttribute('aria-pressed', String(Number(b.getAttribute('data-value')) === target));
      });

      root.querySelectorAll('[data-sample]').forEach(function (b) {
        const sp = b.getAttribute('data-sample').split(',');
        b.setAttribute('aria-pressed', String(Number(sp[0]) === vram && Number(sp[1]) === ram));
      });

      const order = { full: 0, offload: 1, none: 2 };
      items.sort(function (a, b) {
        return order[a.pick.tier] - order[b.pick.tier] || a.pick.total - b.pick.total;
      });

      const q = searchInput.value.trim().toLowerCase();
      const shown = items.filter(function (it) {
        return (state.tab === 'all' || it.pick.tier === state.tab) &&
          (q === '' || it.model.title.toLowerCase().indexOf(q) !== -1);
      });

      list.replaceChildren();
      let lastTier = '';
      shown.forEach(function (it) {
        if (state.tab === 'all' && it.pick.tier !== lastTier) {
          lastTier = it.pick.tier;
          const n = shown.filter(function (x) { return x.pick.tier === lastTier; }).length;
          const h = document.createElement('h3');
          h.className = 'mm-group-title';
          h.textContent = BADGE[lastTier].text + ' (' + n + ')';
          list.appendChild(h);
        }
        list.appendChild(makeCard(it, vram));
      });
      if (shown.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'mm-note';
        empty.textContent = 'No models match this filter.';
        list.appendChild(empty);
      }

      // Best pick rule: the model that fits fully on the GPU with the most
      // parameters (read from the model name), then the largest total.
      const fulls = items.filter(function (it) { return it.pick.tier === 'full'; });
      fulls.sort(function (a, b) {
        return (b.model.paramsB || 0) - (a.model.paramsB || 0) || b.pick.total - a.pick.total;
      });
      bestEl.replaceChildren();
      if (fulls.length > 0) {
        const bp = fulls[0];
        bestEl.hidden = false;
        const k = document.createElement('span');
        k.className = 'mm-kicker';
        k.textContent = 'Best pick for your GPU';
        const t = document.createElement('a');
        t.href = '/calculator/' + encodeURIComponent(bp.model.slug);
        t.className = 'mm-title';
        t.textContent = bp.model.title;
        const d = document.createElement('span');
        d.className = 'mm-meta';
        d.textContent = 'GGUF ' + shortQuant(bp.pick.quant.type) + ' \u00b7 needs ' + bp.pick.total.toFixed(1) + ' GB of ' + vram + ' GB';
        const rule = document.createElement('span');
        rule.className = 'mm-note';
        rule.textContent = 'Rule: fits fully on the GPU, then the most parameters, then the largest total.';
        bestEl.appendChild(k);
        bestEl.appendChild(t);
        bestEl.appendChild(d);
        bestEl.appendChild(rule);
      } else {
        bestEl.hidden = true;
      }

      // Affiliate options: only when the person is looking at something that
      // does not fit fully (a search, or the offload / out-of-memory filter).
      const looking = q !== '' ? shown : state.tab === 'offload' || state.tab === 'none' ? shown : [];
      const anyOver = looking.some(function (it) { return it.pick.tier !== 'full'; });
      affOver.hidden = !(looking.length > 0 && anyOver);
      affFit.hidden = !(looking.length > 0 && !anyOver && q !== '');

      // Saved rig bar
      if (rig && rig.vram) {
        savedEl.hidden = false;
        savedText.textContent = 'Your saved rig: ' + rig.vram + ' GB VRAM \u00b7 ' + rig.ram + ' GB RAM \u00b7 ' + (data.labels[rig.ctx] || '8K');
      } else {
        savedEl.hidden = true;
      }

      summary.textContent =
        'At ' + data.labels[ci] + ' context with ' + vram + ' GB of VRAM and ' + ram + ' GB of RAM, out of ' +
        items.length + ' models: Full GPU fit ' + counts.full + ', Offload required ' + counts.offload +
        ', Out of memory ' + counts.none + '.';

      let text =
        'Estimates for llama.cpp on a single discrete GPU. Each model uses the largest quantization (3-bit or above) that fits fully in VRAM. If none does, the smallest one decides the tier. Offload counts system RAM minus ' +
        data.osReservedRamGb + ' GB kept for the operating system.';
      if (data.contexts[ci] > 32768) {
        text += ' Native context limits are known for only some models, so check each model before relying on this.';
      }
      const left = [];
      if (data.noEstimate > 0) left.push(data.noEstimate + ' without a reliable architecture estimate');
      if (beyondContext > 0) left.push(beyondContext + ' with a native context shorter than this setting');
      if (left.length > 0) text += ' Left out: ' + left.join(' and ') + '.';
      note.textContent = text;
      renderMulti();
    }

    vramInput.addEventListener('input', render);
    ramInput.addEventListener('input', render);
    searchInput.addEventListener('input', render);
    document.querySelectorAll('input[name="mm-ctx"]').forEach(function (r) {
      r.addEventListener('change', render);
    });
    document.querySelectorAll('[data-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const target = btn.getAttribute('data-preset') === 'vram' ? vramInput : ramInput;
        target.value = btn.getAttribute('data-value');
        render();
      });
    });
    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.tab = btn.getAttribute('data-tab');
        tabButtons.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        render();
      });
    });

    root.querySelectorAll('[data-sample]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const parts = btn.getAttribute('data-sample').split(',');
        vramInput.value = parts[0];
        ramInput.value = parts[1];
        render();
      });
    });

    // On phones the controls collapse into one compact bar. From 768px up they
    // are always shown, so the bar is just a heading there.
    const wide = window.matchMedia('(min-width: 768px)');
    function syncBar() {
      bar.disabled = wide.matches;
      bar.setAttribute('aria-expanded', String(wide.matches || controls.classList.contains('is-open')));
    }
    bar.addEventListener('click', function () {
      const open = controls.classList.toggle('is-open');
      bar.setAttribute('aria-expanded', String(open));
    });
    wide.addEventListener('change', syncBar);
    syncBar();

    multiAdd.addEventListener('click', function () {
      addRow(0);
    });
    multiExtra.addEventListener('input', renderMulti);

    function shareUrl() {
      const ci = ctxIndex();
      return window.location.origin + window.location.pathname + '?vram=' + vramInput.value +
        '&ram=' + ramInput.value + '&ctx=' + data.labels[ci];
    }
    function say(msg) {
      shareStatus.textContent = msg;
      window.setTimeout(function () { shareStatus.textContent = ''; }, 2500);
    }
    document.getElementById('mm-copy-link').addEventListener('click', function () {
      const url = shareUrl();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { say('Link copied'); }, function () { say(url); });
      } else {
        say(url);
      }
    });
    document.getElementById('mm-save-rig').addEventListener('click', function () {
      rig = { vram: Number(vramInput.value), ram: Number(ramInput.value), ctx: ctxIndex() };
      try {
        window.localStorage.setItem(RIG_KEY, JSON.stringify(rig));
        say('Saved on this device');
      } catch (e) {
        say('Could not save in this browser');
      }
      render();
    });
    document.getElementById('mm-apply-rig').addEventListener('click', function () {
      if (!rig) return;
      vramInput.value = String(rig.vram);
      ramInput.value = String(rig.ram);
      const radios = document.querySelectorAll('input[name="mm-ctx"]');
      if (radios[rig.ctx]) radios[rig.ctx].checked = true;
      render();
    });

    // Load a shared setup from the URL (?vram=24&ram=32&ctx=8K).
    try {
      const params = new URLSearchParams(window.location.search);
      const v = Number(params.get('vram'));
      const r = Number(params.get('ram'));
      const c = params.get('ctx');
      if (params.has('vram') && v >= 4 && v <= 128) vramInput.value = String(Math.round(v));
      if (params.has('ram') && r >= 8 && r <= 256) ramInput.value = String(Math.round(r));
      if (c) {
        const idx = data.labels.indexOf(String(c).toUpperCase());
        const radios = document.querySelectorAll('input[name="mm-ctx"]');
        if (idx >= 0 && radios[idx]) radios[idx].checked = true;
      }
    } catch (e) { /* ignore a bad URL */ }

    // Start with the two models that have the smallest files, so the sum is
    // visible straight away.
    const smallestFirst = data.models
      .map(function (m, i) {
        return { i: i, size: Math.min.apply(null, m.quants.map(function (q) { return q.sizeGb; })) };
      })
      .sort(function (a, b) { return a.size - b.size; });
    if (smallestFirst.length > 0) addRow(smallestFirst[0].i);
    if (smallestFirst.length > 1) addRow(smallestFirst[1].i);

    render();
  })();
</script>

<style is:global>
  .mm{--mm-full:#15803d;--mm-offload:#f59e0b;--mm-none:#b91c1c;display:flex;flex-direction:column;gap:1.5rem;color:var(--text-primary)}
