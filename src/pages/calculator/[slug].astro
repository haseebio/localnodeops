---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import DockerStackCTA from '../../components/DockerStackCTA.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { parseParamsB, nearestBucket, estimateVram } from '../../lib/vram-math';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, last_synced, quantizations } = entry.data;

const paramsB = parseParamsB(title);
const bucket = nearestBucket(paramsB, title);
const syncedDate = last_synced.slice(0, 10);
const hasEstimate = bucket !== null;

const DEFAULT_CONTEXT = 4096;
const quantEstimates = hasEstimate
  ? quantizations.map((q) => ({
      ...q,
      estimate: estimateVram(q.size_gb, bucket, DEFAULT_CONTEXT),
    }))
  : [];

let fittingHardware: { slug: string; title: string; vramGB: number }[] = [];
if (hasEstimate) {
  const cheapestTotalGb = Math.min(...quantEstimates.map((q) => q.estimate.totalGb));
  const hardwareEntries = await getCollection('hardware');
  fittingHardware = hardwareEntries
    .filter((h) => h.data.vramGB != null && cheapestTotalGb <= h.data.vramGB)
    .map((h) => ({ slug: h.slug, title: h.data.title, vramGB: h.data.vramGB as number }))
    .sort((a, b) => a.vramGB - b.vramGB);
}

const faqs = [
  {
    question: `How is VRAM calculated for ${title}?`,
    answer:
      `Total VRAM combines three things: the model weight size (exact for synced quantizations, from the real .gguf file), ` +
      `the KV cache size (always estimated — see /methodology for why), and a runtime overhead margin of 10% of (weights + KV cache), ` +
      `a rule-of-thumb allowance for CUDA context and activation buffers rather than a fixed number, since it scales with model size.`,
  },
  {
    question: `Why does context length drastically change VRAM requirements?`,
    answer:
      `The KV cache stores attention history so the model doesn't recompute earlier tokens on every step. KV cache size scales ` +
      `linearly with context length, so doubling context roughly doubles that portion of VRAM use. On larger models this can add ` +
      `many gigabytes as context grows from 4K toward 32K or 128K tokens — see the calculator above to see the real numbers for ${title} at different context lengths.`,
  },
  {
    question: `What happens if my GPU doesn't have enough VRAM for ${title}?`,
    answer:
      `Runners like llama.cpp or Ollama can offload remaining layers to system RAM over the PCIe bus. Execution still works, but ` +
      `system RAM bandwidth (roughly 60–80 GB/s for dual-channel DDR5) is far slower than GPU VRAM (roughly 1,000 GB/s), so generation ` +
      `speed typically drops sharply — often from tens of tokens per second down to single digits — the more layers get offloaded.`,
  },
  {
    question: `How can I fit a model into limited VRAM?`,
    answer:
      `A few real options: drop to a smaller quantization (e.g. Q4_K_M instead of Q8_0), reduce context length (KV cache scales with it directly), ` +
      `or quantize the KV cache itself (llama.cpp's --cache-type-k q8_0 --cache-type-v q8_0) to roughly halve KV cache memory. That last option is a real ` +
      `tradeoff, not free — it can introduce a small amount of quality degradation, generally minor for most use cases but worth testing on your own workload before relying on it.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `VRAM requirements for ${title}`,
    description: hasEstimate
      ? `Exact GGUF file sizes and estimated total VRAM requirements for ${title}, by quantization and context length.`
      : `Exact GGUF file sizes for ${title}. Total VRAM estimate not available — no reference architecture closely matches this model.`,
    dateModified: last_synced,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `LocalNodeOps VRAM Calculator — ${title}`,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  ...(hasEstimate
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Dataset',
          name: `${title} — VRAM requirements by quantization`,
          description: `Estimated total VRAM per quantization for ${title}, computed using the ${bucket.label} reference architecture.`,
          variableMeasured: 'VRAM (GB)',
        },
      ]
    : []),
];
---

<BaseLayout
  title={`VRAM Requirements for ${title}`}
  description={`Exact GGUF file sizes${hasEstimate ? ` and estimated VRAM requirements` : ''} for ${title} across ${quantizations.length} quantization${quantizations.length === 1 ? '' : 's'}.`}
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-lg pt-2xl pb-md">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/calculator">Calculator</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{title}</span>
    </nav>

    <p class="text-body-md text-secondary">Synced from Hugging Face — {syncedDate}</p>
    <h1 class="text-display-hero text-primary max-w-reading mt-xs">
      How much VRAM does {title} need?
    </h1>
    <p class="text-body-lg text-secondary max-w-reading mt-md">
      Exact on-disk weight sizes below are pulled directly from Hugging Face.
      {hasEstimate
        ? ' Total VRAM figures also include an estimated KV cache and runtime overhead — see the breakdown per quantization, and the calculator below to adjust context length.'
        : ' A total VRAM estimate isn\'t shown for this model — see why below.'}
    </p>
  </section>

  <section class="max-w-shell mx-auto px-lg pb-xl">
    <h2 class="text-headline-lg text-primary mb-md">By quantization</h2>
    {hasEstimate ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
        {quantEstimates.map((q) => (
          <div class="border border-border rounded-md bg-surface p-md">
            <p class="text-body-md text-secondary m-0">{q.type}</p>
            <p class="font-mono m-0 mt-xs">
              <span class="text-headline-md text-accent-primary">{q.size_gb.toFixed(2)} GB</span>
              <span class="text-body-md text-secondary ml-xs">exact, on disk</span>
            </p>
            <p class="text-body-md text-secondary mt-sm mb-0">
              ~{q.estimate.totalGb.toFixed(2)} GB total estimated VRAM at {DEFAULT_CONTEXT.toLocaleString()} tokens context
              <span class="text-secondary"> (KV cache + overhead estimated, not exact)</span>
            </p>
          </div>
        ))}
      </div>
    ) : (
      <div class="border border-border rounded-md bg-surface p-md max-w-reading">
        <p class="text-body-lg text-primary m-0">
          Precise VRAM estimations are not yet available for this specific architecture or parameter size.
        </p>
        <p class="text-body-md text-secondary mt-sm mb-0">
          Exact on-disk weight sizes for each quantization are still listed below — only the total
          VRAM estimate (KV cache + overhead) is withheld, because none of our reference architectures
          are a close enough match to produce a reliable number.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md mt-md">
          {quantizations.map((q) => (
            <div class="border border-border rounded-md bg-surface-elevated p-md">
              <p class="text-body-md text-secondary m-0">{q.type}</p>
              <p class="font-mono m-0 mt-xs">
                <span class="text-headline-md text-accent-primary">{q.size_gb.toFixed(2)} GB</span>
                <span class="text-body-md text-secondary ml-xs">exact, on disk</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  {fittingHardware.length > 0 && (
    <section class="max-w-shell mx-auto px-lg pb-xl">
      <h2 class="text-headline-lg text-primary mb-md">Hardware this fits</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
        {fittingHardware.map((h) => (
          <a href={`/hardware/${h.slug}`}
            data-astro-prefetch
            class="border border-border rounded-md bg-surface p-md no-underline cursor-pointer
              transition-colors hover:border-accent-primary hover:bg-surface-elevated"
          >
            <p class="text-headline-md text-primary m-0">{h.title}</p>
            <p class="text-body-md text-secondary mt-xs mb-0">{h.vramGB} GB VRAM</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {hasEstimate && (
    <section class="max-w-shell mx-auto px-lg pb-xl">
      <VramCalculator preselectedModel={entry.slug} />
    </section>
  )}

  <section class="max-w-shell mx-auto px-lg pb-xl">
    <DockerStackCTA />
  </section>

  <section class="max-w-shell mx-auto px-lg pb-2xl">
    <FAQAccordion items={faqs} title="FAQ" />
  </section>
</BaseLayout>