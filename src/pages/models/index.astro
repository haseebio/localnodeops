---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getModelRows, FAMILY_ORDER } from '../../lib/model-table';

// Model directory hub. Every number comes from lib/model-table.ts, which uses
// the same shared math as the calculator, so nothing here is typed by hand.
const rows = await getModelRows();
const families = FAMILY_ORDER.filter((f) => rows.some((r) => r.family === f));
const fmt = (n: number | null) => (n === null ? 'n/a' : n.toFixed(1) + ' GB');
---

<BaseLayout
  title="Local LLM Model Directory: VRAM by Model"
  description="Every synced local LLM with its exact Q4_K_M file size and estimated total VRAM at 8K context. Filter by what fits a 16 GB or 24 GB GPU."
>
  <section class="max-w-shell mx-auto px-md sm:px-lg pt-md sm:pt-lg pb-sm">
    <h1 class="text-display-hero text-primary max-w-reading">Local LLM model directory</h1>
    <p class="text-body-md sm:text-body-lg text-secondary max-w-reading mt-xs">
      {rows.length} synced models with their exact Q4_K_M file size and the estimated total VRAM at 8K context
      (weights + KV cache) x 1.10. The KV cache is always an estimate. Free, no sign-up.
    </p>
  </section>

  <section class="max-w-shell mx-auto px-md sm:px-lg pb-xl">
    <div id="models-controls" class="mdl-controls">
      <label for="models-search" class="kicker">Find a model</label>
      <input id="models-search" type="search" class="mdl-input" placeholder="Search, e.g. 70B or qwen" />
      <div class="mdl-chips" role="group" aria-label="Filter by memory">
        <button type="button" class="mdl-chip" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="mdl-chip" data-filter="16" aria-pressed="false">Fits 16 GB</button>
        <button type="button" class="mdl-chip" data-filter="24" aria-pressed="false">Fits 24 GB</button>
        <button type="button" class="mdl-chip" data-filter="48" aria-pressed="false">Needs 48 GB+</button>
      </div>
      <p class="mdl-note">
        Fit is the total at 8K context against GPU memory alone. "Needs 48 GB+" means the total is above 32 GB.
        Models with no reliable architecture estimate show the file size only.
      </p>
    </div>

    <p id="models-empty" class="mdl-note" hidden>No models match this filter.</p>

    {families.map((fam) => (
      <section class="mdl-family" data-family={fam}>
        <h2 class="mdl-family-title">{fam}</h2>
        <div class="mdl-grid">
          {rows.filter((r) => r.family === fam).map((r) => (
            <a href={`/calculator/${r.slug}`} class="card-link mdl-card" data-name={r.name.toLowerCase()} data-total={r.total8kGb ?? ''}>
              <div class="mdl-card-top">
                <span class="tag">{r.type}</span>
                <span class="tag tag-estimated">Estimated</span>
              </div>
              <h3 class="mdl-card-title">{r.name}</h3>
              <dl class="mdl-facts">
                <div><dt>Q4_K_M file</dt><dd class="num">{fmt(r.q4FileGb)}</dd></div>
                <div><dt>Total at 8K</dt><dd class="num mdl-total">{r.total8kGb !== null ? fmt(r.total8kGb) : 'No total'}</dd></div>
              </dl>
              {r.hasEstimate ? (
                <span class:list={['fit-badge', r.fits['3090'] === 'fits' ? 'fit-fits' : r.fits['3090'] === 'offload' ? 'fit-offload' : 'fit-oom']}>
                  {r.fits['3090'] === 'fits' ? 'Fits 24 GB' : r.fits['3090'] === 'offload' ? '24 GB: needs offload' : '24 GB: does not fit'}
                </span>
              ) : (
                <span class="mdl-note">No total: see <span class="mdl-link">methodology</span></span>
              )}
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="mdl-note mdl-foot">
      File sizes are synced from Hugging Face. Totals use the same formula as the
      <a href="/hardware">VRAM calculator</a>; see the <a href="/methodology">methodology</a>.
      To check your own GPU, open the <a href="/matchmaker">matchmaker</a>.
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const search = document.getElementById('models-search');
    const chips = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
    const cards = Array.prototype.slice.call(document.querySelectorAll('.mdl-card'));
    const families = Array.prototype.slice.call(document.querySelectorAll('.mdl-family'));
    const empty = document.getElementById('models-empty');
    let filter = 'all';
    function pass(card) {
      const total = card.getAttribute('data-total');
      const t = total === '' ? null : Number(total);
      if (filter === 'all') return true;
      if (t === null) return false;
      if (filter === '16') return t <= 16;
      if (filter === '24') return t <= 24;
      return t > 32;
    }
    function render() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach(function (c) {
        const ok = pass(c) && (q === '' || c.getAttribute('data-name').indexOf(q) !== -1);
        c.hidden = !ok;
        if (ok) shown++;
      });
      families.forEach(function (f) {
        f.hidden = !f.querySelector('.mdl-card:not([hidden])');
      });
      empty.hidden = shown !== 0;
    }
    search.addEventListener('input', render);
    chips.forEach(function (b) {
      b.addEventListener('click', function () {
        filter = b.getAttribute('data-filter');
        chips.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        render();
      });
    });
  })();
</script>

<style is:global>
  .mdl-controls{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.25rem}
  .mdl-input{width:100%;max-width:28rem;min-height:2.75rem;padding:0 .8rem;border:1px solid var(--border-color);border-radius:.5rem;background:var(--bg-base);color:var(--text-primary);font-size:1rem}
  .mdl-chips{display:flex;flex-wrap:wrap;gap:.4rem}
  .mdl-chip{min-height:2.75rem;padding:0 .9rem;border:1px solid var(--border-color);border-radius:9999px;background:var(--bg-base);color:var(--text-primary);font-size:.9rem;cursor:pointer}
  .mdl-chip[aria-pressed="true"]{background:var(--accent-primary-solid);border-color:var(--accent-primary-solid);color:var(--on-primary);font-weight:700}
  .mdl-note{margin:.25rem 0 0;font-size:.85rem;line-height:1.5;color:var(--text-secondary)}
  .mdl-foot{margin-top:1.5rem}
  .mdl-foot a,.mdl-note a{color:var(--accent-primary);font-weight:700}
  .mdl-family{margin-top:1.5rem}
  .mdl-family-title{margin:0 0 .6rem;font-size:1.25rem;font-weight:700;color:var(--text-primary)}
  .mdl-grid{display:grid;gap:.75rem;grid-template-columns:1fr}
  @media (min-width:640px){.mdl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (min-width:1024px){.mdl-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .mdl-card{display:flex;flex-direction:column;gap:.5rem;padding:.9rem 1rem;text-decoration:none;color:inherit}
  .mdl-card[hidden],.mdl-family[hidden]{display:none}
  .mdl-card-top{display:flex;gap:.4rem;flex-wrap:wrap}
  .mdl-card-title{margin:0;font-size:1.05rem;font-weight:700;line-height:1.3;color:var(--text-primary);overflow-wrap:anywhere}
  .mdl-facts{display:flex;gap:1.25rem;margin:0}
  .mdl-facts dt{font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-secondary)}
  .mdl-facts dd{margin:0;font-size:1.05rem;font-weight:700;color:var(--text-primary)}
  .mdl-total{color:var(--accent-primary)!important}
  .mdl-link{color:var(--accent-primary);font-weight:700}
</style>
