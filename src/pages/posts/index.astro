---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// Categories come from the posts' own frontmatter; none are invented.
const categories = [...new Set(posts.map((p) => p.data.category))].sort();

// "Start here": the three most useful guides first, in this order.
const START = ['how-to-calculate-local-llm-vram', 'why-your-24gb-vram-isnt-enough', 'q4-km-vs-q8-0-vram-difference'];
const startPosts = START.map((slug) => posts.find((p) => p.slug === slug)).filter((p) => !!p);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'LocalNodeOps Guides',
  },
];
---

<BaseLayout
  title="Local LLM Guides: VRAM, Hardware, Errors"
  description="Guides and write-ups on local LLM orchestration, hardware sizing, and inference troubleshooting."
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-md sm:px-lg pt-md sm:pt-lg pb-md">
    <h1 class="text-display-hero text-primary max-w-reading">Guides</h1>
    <p class="text-body-md sm:text-body-lg text-secondary max-w-reading mt-xs">
      Guides and write-ups on local LLM orchestration, hardware sizing, and
      inference troubleshooting. {posts.length} guides, newest first.
    </p>
  </section>

  {startPosts.length > 0 && (
    <section class="max-w-shell mx-auto px-md sm:px-lg pb-lg" aria-labelledby="start-here">
      <h2 id="start-here" class="text-headline-md text-primary mb-sm">Start here</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
        {startPosts.map((post) => <PublicationCard entry={post!} />)}
      </div>
    </section>
  )}

  <section class="max-w-shell mx-auto px-md sm:px-lg pb-2xl">
    <h2 class="text-headline-md text-primary mb-sm">All guides</h2>
    {posts.length === 0 ? (
      <p class="text-body-lg text-secondary max-w-reading">No posts published yet.</p>
    ) : (
      <>
        <div class="mb-md">
          <CategoryFilter categories={categories} label="Filter guides by category" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
          {posts.map((post) => (
            <div data-category={post.data.category} class="h-full">
              <PublicationCard entry={post} />
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
