---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import StickyActionBar from '../../components/StickyActionBar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props as Props;
const { Content } = await entry.render();
const { title, excerpt, category, pubDate, author, readingTime, faq } = entry.data;

// tsconfig extends astro/tsconfigs/base (non-strict), so Zod infers faq items with
// optional fields. The schema guarantees both are strings; assert that here so
// the array matches FAQAccordion's required FAQItem shape.
const faqItems = (faq ?? []).map((item) => ({
  question: item.question as string,
  answer: item.answer as string,
}));

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Typed explicitly as object[] — without this, TS infers the array's
// element type from the first literal (the TechArticle shape below) and
// then rejects the differently-shaped FAQPage object pushed further down.
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: excerpt,
    datePublished: pubDate.toISOString(),
    author: {
      '@type': 'Person',
      name: author,
    },
  },
];

if (faq && faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---

<BaseLayout title={title} description={excerpt} jsonLd={jsonLd}>
  <div class="max-w-reading mx-auto px-lg py-xl">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/posts">Blog</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{title}</span>
    </nav>

    <p class="text-body-md text-secondary">
      {category} <span aria-hidden="true">·</span> {formattedDate}
      <span aria-hidden="true">·</span> {readingTime} min read
    </p>

    <h1 class="text-display-hero text-primary mt-xs">{title}</h1>
    <p class="text-body-lg text-secondary mt-sm">{excerpt}</p>

    <p class="text-body-md text-secondary mt-sm">
      Written by <span class="text-primary">{author}</span>
    </p>

    <div class="mt-md">
      <ArticleActions title={title} />
    </div>

    <div class="article-shell mt-lg">
      <div class="docs-content" id="post-content">
        <Content />
      </div>
    </div>

    <FAQAccordion items={faqItems} title="Frequently asked questions" />
  </div>

  <StickyActionBar />
</BaseLayout>

<script is:inline>
  (function () {
    const content = document.getElementById('post-content');
    if (!content) return;

    content.querySelectorAll('pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.className = 'copy-btn';
      btn.addEventListener('click', function () {
        const code = pre.querySelector('code');
        const text = code ? code.textContent : pre.textContent;
        navigator.clipboard.writeText(text || '').then(function () {
          btn.textContent = 'Copied';
          setTimeout(function () {
            btn.textContent = 'Copy';
          }, 2000);
        });
      });
      pre.appendChild(btn);
    });
  })();
</script>