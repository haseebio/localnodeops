---
import BaseLayout from '../layouts/BaseLayout.astro';
import HardwareCard from '../components/HardwareCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const hardwareEntries = (await getCollection('hardware')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const postEntries = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categories = [...new Set(hardwareEntries.map((entry) => entry.data.category))];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'LocalNodeOps Hardware Benchmarks',
    about: 'Local AI inference hardware benchmarks and infrastructure guides',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: hardwareEntries.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(`/hardware/${entry.slug}`, Astro.site).toString(),
    })),
  },
];
---

<BaseLayout
  title="Local AI Hardware Benchmarks & Infrastructure Guides"
  description="Local LLM inference hardware benchmarks, plus guides on quantization, VRAM budgeting, and self-hosted infrastructure."
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-lg pt-2xl pb-xl">
    <h1 class="text-display-hero text-primary max-w-reading">
      Know what your hardware can actually run.
    </h1>
    <p class="text-body-lg text-secondary max-w-reading mt-md">
      LocalNodeOps estimates what your hardware can actually run: VRAM needs,
      tokens-per-second figures and quantization trade-offs for consumer and
      prosumer hardware, with every figure labeled by where it comes from.
    </p>
  </section>

  <section class="max-w-shell mx-auto px-lg pb-xl">
    <h2 class="text-headline-lg text-primary">Hardware benchmarks</h2>
    <p class="text-body-md text-secondary max-w-reading mt-xs mb-md">
      Each card is tagged verified, community-reported, or estimated. Right
      now every card is estimated: the figures come from third-party
      measurements, published papers or bandwidth calculations, and each card
      says which. None has been reproduced on LocalNodeOps hardware yet.
    </p>

    <div class="mb-md">
      <CategoryFilter categories={categories} />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {hardwareEntries.map((entry) => (
        <HardwareCard entry={entry} />
      ))}
    </div>
  </section>

  <section class="max-w-shell mx-auto px-lg pb-2xl">
    <h2 class="text-headline-lg text-primary">Latest from the blog</h2>
    <p class="text-body-md text-secondary max-w-reading mt-xs mb-md">
      Guides on quantization, VRAM budgeting, and diagnosing common local
      inference errors.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
      {postEntries.map((entry) => (
        <PublicationCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>