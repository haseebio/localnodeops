---
import BaseLayout from '../layouts/BaseLayout.astro';

// Author fields below are exactly what was provided directly — name,
// tagline, location, and social links. Nothing invented.
const author = {
  name: 'Muhammad Haseeb Ur Rehman',
  tagline:
    'Full Stack + AI Engineer | React.js • Next.js • Node.js • Python | AI-Powered Applications | LLM Integrations | Building Scalable Web Solutions',
  location: 'Lahore, Punjab, Pakistan',
  sameAs: [
    { url: 'https://github.com/haseebio', label: 'GitHub' },
    { url: 'https://www.linkedin.com/in/haseebio', label: 'LinkedIn' },
    { url: 'https://haseebio-portfolio.netlify.app', label: 'Portfolio' },
  ],
};

const pillars = [
  {
    title: 'Experience',
    body: 'Benchmark figures are labeled verified (measured directly on hardware we own or have direct access to), community-reported (submitted by someone else, not independently verified), or estimated (architectural reasoning and published specs, not yet measured on physical hardware) — the three are never blended into one number, and none is presented as more certain than it is.',
  },
  {
    title: 'Expertise',
    body: 'Coverage focuses on the practical side of local inference: quantization trade-offs, VRAM budgeting, and diagnosing failures in CUDA, vLLM, Ollama, and llama.cpp — the tools people actually run in production and at home.',
  },
  {
    title: 'Trustworthiness',
    body: 'Benchmark methodology, hardware specs, and software versions are published alongside every result. Corrections are dated, not silently edited. This site does participate in affiliate programs with select cloud GPU providers and with Amazon Associates — disclosed inline wherever a link appears, not just buried in Terms — and those relationships never influence the calculator\u2019s math or which local hardware profiles a configuration is shown to fit.',
  },
];

const methodology = [
  'Every figure is tagged verified (measured directly on hardware we control), community-reported (submitted by someone else, not independently verified), or estimated (derived from published specs and architectural reasoning, not yet measured) — the three are never blended into one number.',
  'The VRAM calculator states plainly which parts of its output are exact (synced file sizes) and which are estimated (KV cache math) — see its own footnote for the breakdown.',
  'Hardware specs and software versions are published next to results, not buried in a separate methodology page nobody reads.',
  'Corrections are dated when made, not quietly rewritten.',
    'Affiliate links (RunPod and Amazon Associates) appear in two kinds of places: a labeled suggestion in the calculator (a cloud GPU when a configuration exceeds local hardware, an Amazon link or a rental line when it fits) and inside some posts and docs, with a disclosure. They never change the VRAM math itself, which is computed identically with or without an affiliate relationship.',
];

// The numbers the calculator actually uses. Each line matches the code.
const mathRules = [
  {
    rule: 'Total VRAM = (Weights + KV Cache) × 1.10',
    note: 'The extra 10% is an estimate of runtime overhead, not a measurement.',
  },
  {
    rule: 'Q4_K_M quantization = 4.83 bits per weight',
    note: 'Used for generic estimates. When you pick a synced model, its real file size is used instead, and real files vary by model.',
  },
  {
    rule: 'macOS Metal GPU allocation cap = about 75% of system RAM',
    note: 'The usual default on Apple Silicon. It varies by macOS version and can be raised.',
  },
  {
    rule: 'System RAM kept for the operating system = 4 GB',
    note: 'Subtracted before counting RAM for CPU offload.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).toString(),
    name: author.name,
    description: author.tagline,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Lahore',
      addressRegion: 'Punjab',
      addressCountry: 'PK',
    },
    sameAs: author.sameAs.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About LocalNodeOps',
  },
];
---

<BaseLayout
  title="About LocalNodeOps & VRAM Math Methodology"
  description="Who runs LocalNodeOps, how figures are sourced and labeled, and the editorial standards behind every guide."
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-lg pt-2xl pb-lg">
    <h1 class="text-display-hero text-primary max-w-reading">About LocalNodeOps</h1>
    <p class="text-body-lg text-secondary max-w-reading mt-md">
            LocalNodeOps estimates what local LLM hardware can run. It exists
      because much of the "which GPU should I buy for local AI" advice
      online is outdated, unverified, or copied from a vendor spec sheet.
      This site tries to close that gap: every figure is labeled by where
      it comes from (a third-party measurement, a published paper, or a
      calculation), and the estimation math is shown rather than hidden.
    </p>
  </section>

  <!-- Author identity card -->
  <section class="max-w-shell mx-auto px-lg pb-xl">
    <div class="border border-border rounded-md bg-surface p-lg flex flex-col sm:flex-row gap-lg items-start">
      <div
        class="w-20 h-20 shrink-0 rounded-full bg-accent-primary-container
          flex items-center justify-center text-headline-lg font-bold text-primary font-mono"
        aria-hidden="true"
      >
        {author.name.slice(0, 1)}
      </div>

      <div class="flex-1 min-w-0">
        <h2 class="text-headline-lg text-primary m-0">{author.name}</h2>
        <p class="text-body-md text-secondary mt-[0.125rem] mb-xs">{author.location}</p>
        <p class="text-body-lg text-secondary m-0">{author.tagline}</p>
        <p class="text-body-lg text-primary mt-sm m-0">
          Built and maintained by {author.name} (<a href="https://github.com/haseebio" rel="me" class="text-accent-primary hover:underline">@haseebio</a>), a Full-Stack &amp; AI Engineer.
        </p>

        <div class="flex flex-wrap items-center gap-sm mt-md">
          {author.sameAs.map((s) => (
            <a href={s.url}
              rel="me"
              class="inline-flex items-center min-h-touch-min px-md rounded-full border border-border
                text-body-md text-primary no-underline cursor-pointer transition-colors
                hover:border-accent-primary hover:bg-accent-primary-container hover:text-primary"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- E-E-A-T pillars -->
  <section class="max-w-shell mx-auto px-lg pb-xl">
    <h2 class="text-headline-lg text-primary mb-md">How this site operates</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
      {pillars.map((pillar) => (
        <div class="border border-border rounded-md bg-surface p-md">
          <h3 class="text-headline-md text-primary m-0">{pillar.title}</h3>
          <p class="text-body-md text-secondary mt-xs m-0">{pillar.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Methodology -->
  <section class="max-w-shell mx-auto px-lg pb-xl">
    <h2 class="text-headline-lg text-primary mb-md">Methodology, in practice</h2>
    <div class="border border-border rounded-md bg-surface p-md max-w-reading">
      <ul class="flex flex-col gap-sm m-0 pl-lg text-body-lg text-secondary">
        {methodology.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- VRAM math rules -->
  <section class="max-w-shell mx-auto px-lg pb-xl">
    <h2 class="text-headline-lg text-primary mb-md">How the VRAM math works</h2>
    <div class="border border-border rounded-md bg-surface p-md max-w-reading">
      <ul class="flex flex-col gap-md m-0 pl-lg text-body-lg text-secondary">
        {mathRules.map((r) => (
          <li>
            <code class="font-mono text-primary">{r.rule}</code>
            <span class="block text-body-md mt-xs">{r.note}</span>
          </li>
        ))}
      </ul>
      <p class="text-body-md text-secondary mt-md m-0">
        Not included: the calculator does not subtract memory used by your desktop or display
        from VRAM. If the same GPU drives your screen, leave some VRAM free.
      </p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="max-w-shell mx-auto px-lg pb-2xl">
    <div class="border border-border rounded-md bg-surface-elevated p-md flex flex-col sm:flex-row sm:items-center sm:justify-between gap-md">
      <p class="text-body-lg text-primary m-0">
        Found something wrong, or want a specific model benchmarked?
      </p>
      <a href="/contact"
        class="inline-flex items-center justify-center min-h-touch-min px-md rounded-md
          bg-accent-primary-solid text-accent-on-primary text-body-md no-underline cursor-pointer
          hover:opacity-90 transition-opacity"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>