---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { RUNPOD_URL, AFFILIATE_REL, AFFILIATE_DISCLOSURE } from '../../lib/affiliate';

export async function getStaticPaths() {
  const entries = await getCollection('errors');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { module, errorCode, title, seoTitle, summary, severity, faq } = entry.data;

// Same-module errors (not this one) for the "Related errors" list.
const related = (await getCollection('errors'))
  .filter((e) => e.data.module === module && e.slug !== entry.slug)
  .slice(0, 3);
// The only pages that carry an affiliate line: out-of-memory errors.
const isOom = /out-of-memory|oom/.test(entry.slug);

// Same normalization as posts/[slug].astro — tsconfig's non-strict base
// makes Zod infer faq items with optional fields, but the schema
// guarantees both are strings, so assert that here to match
// FAQAccordion's required FAQItem shape.
const faqItems = (faq ?? []).map((item) => ({
  question: item.question as string,
  answer: item.answer as string,
}));

// Filled, tinted backgrounds — matches the errors listing page
// (src/pages/errors/index.astro), which already moved off the old
// thin 1px outline pills for the same low-contrast reason.
const SEVERITY_STYLES: Record<string, string> = {
  critical: 'bg-accent-error-container text-primary',
  warning: 'bg-accent-secondary-container text-primary',
  info: 'bg-surface-elevated text-secondary border border-border',
};

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: summary,
  },
];

if (faq && faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---

<BaseLayout title={seoTitle ?? `${errorCode}: ${title}`} description={summary} jsonLd={jsonLd}>
  <div class="max-w-reading mx-auto px-lg py-xl">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/errors">Errors</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <a href={`/errors#${module}`}>{module}</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{errorCode}</span>
    </nav>

    <div class="flex items-center gap-sm flex-wrap">
      <code class="text-code-mono text-secondary font-mono">{errorCode}</code>
      <span
        class:list={[
          'text-body-md rounded-full px-sm py-[0.125rem] whitespace-nowrap font-bold',
          SEVERITY_STYLES[severity],
        ]}
      >
        {severity}
      </span>
    </div>

    <h1 class="text-display-hero text-primary mt-xs err-h1"><code class="font-mono">{errorCode}</code></h1>
    <p class="text-headline-md text-primary mt-xs m-0">{title}</p>
    <p class="text-body-lg text-secondary mt-sm">{summary}</p>

    <div class="mt-md">
      <ArticleActions title={title} />
    </div>

    <div class="article-shell mt-lg">
      <div class="docs-content">
        <Content />
      </div>
    </div>

    <FAQAccordion items={faqItems} title="Frequently asked questions" />

    <section class="callout mt-lg" aria-labelledby="stuck-title">
      <p id="stuck-title" class="kicker m-0">Still stuck?</p>
      <p class="text-body-md text-secondary m-0 mt-xs">
        Check whether your model, quantization and context length fit your GPU in the
        <a href="/hardware" class="text-accent-primary font-bold hover:underline">VRAM calculator</a>
        or the <a href="/matchmaker" class="text-accent-primary font-bold hover:underline">GPU matchmaker</a>.
      </p>
      {isOom && (
        <>
          <p class="text-secondary m-0 mt-sm" style="font-size:.8rem">{AFFILIATE_DISCLOSURE}</p>
          <p class="text-body-md text-secondary m-0 mt-xs">
            Still hitting OOM on every run? Rent a cloud GPU by the hour
            (<a href={RUNPOD_URL} target="_blank" rel={AFFILIATE_REL} class="text-accent-primary font-bold hover:underline" data-umami-event="error-runpod">RunPod</a>, affiliate link).
          </p>
        </>
      )}
    </section>

    {related.length > 0 && (
      <section class="mt-lg" aria-labelledby="related-errors">
        <h2 id="related-errors" class="text-headline-md text-primary">Related {module} errors</h2>
        <ul class="post-related">
          {related.map((r) => (
            <li><a href={`/errors/${r.slug}`} class="card-link post-pn-card"><code class="font-mono text-secondary">{r.data.errorCode}</code><span>{r.data.title}</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>