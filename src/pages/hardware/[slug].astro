---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import { parseParamsB, nearestBucket, estimateVram } from '../../lib/vram-math';

export async function getStaticPaths() {
  const entries = await getCollection('hardware');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, category, metricLabel, metricValue, status, summary, publishedAt, vramGB } = entry.data;

const STATUS_LABELS: Record<string, string> = {
  verified: 'Verified',
  community: 'Community-reported',
  estimated: 'Estimated — not yet benchmarked',
};

const STATUS_STYLES: Record<string, string> = {
  verified: 'border-accent-tertiary text-accent-tertiary',
  community: 'border-border text-secondary',
  estimated: 'border-accent-secondary text-secondary',
};

const STATUS_SCHEMA_DESCRIPTIONS: Record<string, string> = {
  verified: `Verified benchmark: ${metricValue} ${metricLabel}`,
  community: `Community-reported value, not independently verified: ${metricValue} ${metricLabel}`,
  estimated: `Estimated value, not yet independently benchmarked: ${metricValue} ${metricLabel}`,
};

// "Models that fit this GPU" — driven directly by the schema's vramGB
// field now, not a title regex. Only runs when vramGB is set (i.e. a
// real GPU entry that opted in), never inferred.
const DEFAULT_CONTEXT = 4096;

let fittingModels: { slug: string; title: string; bestTotalGb: number }[] = [];
if (vramGB != null) {
  const allModels = await getCollection('models');
  fittingModels = allModels
    .map((m) => {
      const paramsB = parseParamsB(m.data.title);
      const bucket = nearestBucket(paramsB, m.data.title);
      if (!bucket) return null;
      const totals = m.data.quantizations.map((q) => estimateVram(q.size_gb, bucket, DEFAULT_CONTEXT).totalGb);
      const bestTotalGb = Math.min(...totals);
      if (bestTotalGb > vramGB) return null;
      return { slug: m.slug as string, title: m.data.title, bestTotalGb };
    })
    .filter((m) => m !== null)
    .sort((a, b) => b.bestTotalGb - a.bestTotalGb)
    .slice(0, 6);
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: summary,
    datePublished: publishedAt.toISOString(),
    about: {
      '@type': 'Dataset',
      name: `${title} — ${metricLabel}`,
      description: STATUS_SCHEMA_DESCRIPTIONS[status],
      variableMeasured: metricLabel,
      value: metricValue,
    },
  },
];
---

<BaseLayout title={title} description={summary} jsonLd={jsonLd}>
  <div class="max-w-reading mx-auto px-lg py-xl">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/hardware">Hardware</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{title}</span>
    </nav>

    <p class="text-body-md text-secondary font-mono uppercase tracking-wide">{category}</p>
    <h1 class="text-display-hero text-primary mt-xs">{title}</h1>
    <p class="text-body-lg text-secondary mt-sm">{summary}</p>

    <div class="mt-md">
      <ArticleActions title={title} />
    </div>

    <div class="hero-metric-card mt-lg">
      <span class="text-display-hero text-accent-primary font-mono">{metricValue}</span>
      <span class="text-body-lg text-secondary">{metricLabel}</span>
      <span class:list={['pill ml-auto', STATUS_STYLES[status]]}>{STATUS_LABELS[status]}</span>
    </div>

    <div class="article-shell mt-lg">
      <div class="docs-content">
        <Content />
      </div>
    </div>

    {fittingModels.length > 0 && (
      <div class="mt-lg">
        <h2 class="text-headline-lg text-primary mb-md">Models that fit this GPU</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
          {fittingModels.map((m) => (
            <a href={`/calculator/${m.slug}`}
              data-astro-prefetch
              class="border border-border rounded-md bg-surface p-md no-underline cursor-pointer
                transition-colors hover:border-accent-primary hover:bg-surface-elevated"
            >
              <p class="text-headline-md text-primary m-0">{m.title}</p>
              <p class="text-body-md text-secondary mt-xs mb-0">
                ~{m.bestTotalGb.toFixed(1)} GB at best-fitting quantization
              </p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>