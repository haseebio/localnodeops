---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';
import { getModelRows, APPLE_GPU_SHARE } from '../../lib/model-table';
import { getHardwareAction } from '../../lib/hardware-actions';
import { AFFILIATE_REL, AFFILIATE_DISCLOSURE } from '../../lib/affiliate';
import { parseParamsB, nearestBucket, estimateVram, getModelArch } from '../../lib/vram-math';

export async function getStaticPaths() {
  const entries = await getCollection('hardware');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, category, metricLabel, metricValue, status, summary, publishedAt, vramGB } = entry.data;

const STATUS_LABELS: Record<string, string> = {
  verified: 'Verified',
  community: 'Community-reported',
  estimated: 'Estimated — not yet benchmarked',
};

const STATUS_STYLES: Record<string, string> = {
  verified: 'border-accent-tertiary text-accent-tertiary',
  community: 'border-border text-secondary',
  estimated: 'border-accent-secondary text-secondary',
};

const STATUS_SCHEMA_DESCRIPTIONS: Record<string, string> = {
  verified: `Verified benchmark: ${metricValue} ${metricLabel}`,
  community: `Community-reported value, not independently verified: ${metricValue} ${metricLabel}`,
  estimated: `Estimated value, not yet independently benchmarked: ${metricValue} ${metricLabel}`,
};

// "Models that fit this GPU" — driven by the schema's vramGB field.
// Excludes sub-3-bit quantizations (IQ1/IQ2/Q2) from the "best-fitting"
// pick: these numerically minimize file size but are widely considered
// too lossy to be a real recommendation, especially at large parameter
// counts. Without this filter a 70B model could show a ~12GB "fits"
// figure using an IQ2 quant, directly contradicting this page's own
// prose about what a 70B model actually requires. If a model has no
// quantization above that floor, it's excluded from the list entirely
// rather than shown with a misleading number.
const DEFAULT_CONTEXT = 4096;
const MIN_USABLE_BITS_PER_WEIGHT = 3;

function isUsableQuantType(type: string): boolean {
  const match = type.match(/I?Q(\d)/i);
  if (!match) return true; // unknown naming (e.g. F16/F32) — don't exclude
  return parseInt(match[1], 10) >= MIN_USABLE_BITS_PER_WEIGHT;
}

let fittingModels: { slug: string; title: string; bestTotalGb: number }[] = [];
if (vramGB != null) {
  const allModels = await getCollection('models');
  fittingModels = allModels
    .map((m) => {
      const paramsB = parseParamsB(m.data.title);
      const bucket = getModelArch(m.slug) ?? nearestBucket(paramsB, m.data.title);
      if (!bucket) return null;

      const usableQuants = m.data.quantizations.filter((q) => isUsableQuantType(q.type));
      if (usableQuants.length === 0) return null;

      const totals = usableQuants.map((q) => estimateVram(q.size_gb, bucket, DEFAULT_CONTEXT).totalGb);
      const bestTotalGb = Math.min(...totals);
      if (bestTotalGb > vramGB) return null;
      return { slug: m.slug as string, title: m.data.title, bestTotalGb };
    })
    .filter((m) => m !== null)
    .sort((a, b) => b.bestTotalGb - a.bestTotalGb)
    .slice(0, 6);
}

// What fits: a 32B and a 70B model at Q4_K_M, at 8K / 16K / 32K context, against
// the memory this card states (Mac: 75% GPU rule). Same math as the calculator.
const modelRows = await getModelRows();
const r32 = modelRows.find((r) => r.slug === 'bartowski-deepseek-r1-distill-qwen-32b-gguf');
const r70 = modelRows.find((r) => r.slug === 'bartowski-meta-llama-3-1-70b-instruct-gguf');
const memGb = vramGB ?? (entry.slug.startsWith('mac-mini') ? 16 * APPLE_GPU_SHARE : null);
const fitRows =
  memGb && r32 && r70
    ? [r32, r70].map((r) => ({
        name: r.name,
        cells: [r.total8kGb, r.total16kGb, r.total32kGb].map((t) => (t === null ? null : { t, fits: t <= memGb })),
      }))
    : [];
const action = getHardwareAction(entry.slug, r70?.total8kGb ?? null);
const bandwidth = summary.match(/([\d,.]+)\s*GB\/s/)?.[0] ?? null;
const allHardware = await getCollection('hardware');
const relatedHw = [
  ...allHardware.filter((h) => h.slug !== entry.slug && h.data.category === category),
  ...allHardware.filter((h) => h.slug !== entry.slug && h.data.category !== category),
].slice(0, 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Hardware', item: new URL('/hardware/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: title, item: new URL(`/hardware/${entry.slug}/`, Astro.site).toString() },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: summary,
    datePublished: publishedAt.toISOString(),
    about: {
      '@type': 'Dataset',
      name: `${title} — ${metricLabel}`,
      description: STATUS_SCHEMA_DESCRIPTIONS[status],
      variableMeasured: metricLabel,
      value: metricValue,
      creator: {
        '@type': 'Organization',
        name: 'LocalNodeOps',
        url: 'https://localnodeops.com',
      },
      license: 'https://creativecommons.org/licenses/by/4.0/',
    },
  },
];
---

<BaseLayout title={entry.data.seoTitle ?? title} description={summary} jsonLd={jsonLd}>
  <div class="max-w-reading mx-auto px-lg py-xl">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/hardware">Hardware</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{title}</span>
    </nav>

    <p class="text-body-md text-secondary font-mono uppercase tracking-wide">{category}</p>
    <h1 class="text-display-hero text-primary mt-xs">{title}</h1>
    <p class="text-body-lg text-secondary mt-sm">{summary}</p>

    <div class="mt-md">
      <ArticleActions title={title} />
    </div>

    <div class="hero-metric-card mt-lg">
      <span class="text-display-hero text-accent-primary font-mono">{metricValue}</span>
      <span class="text-body-lg text-secondary">{metricLabel}</span>
      <span class:list={['pill ml-auto', STATUS_STYLES[status]]}>{STATUS_LABELS[status]}</span>
    </div>

    <div class="article-shell mt-lg">
      <div class="docs-content">
        <Content />
      </div>
    </div>

    <section class="mt-lg" aria-labelledby="specs-title">
      <h2 id="specs-title" class="text-headline-lg text-primary mb-md">Spec summary</h2>
      <dl class="mdl-facts" style="flex-wrap:wrap;gap:1rem 2rem">
        <div><dt>Type</dt><dd>{category}</dd></div>
        {memGb && <div><dt>Memory</dt><dd class="num">{vramGB ?? 16} GB{entry.slug.startsWith('mac-mini') ? ' unified' : ''}</dd></div>}
        {bandwidth && <div><dt>Bandwidth</dt><dd class="num">{bandwidth}</dd></div>}
        <div><dt>Evidence</dt><dd>{STATUS_LABELS[status]}</dd></div>
      </dl>
    </section>

    {fitRows.length > 0 && memGb && (
      <section class="mt-lg" aria-labelledby="fits-title">
        <h2 id="fits-title" class="text-headline-lg text-primary mb-xs">What fits</h2>
        <p class="text-body-md text-secondary m-0 mb-md">
          Q4_K_M, llama.cpp, against {Number.isInteger(memGb) ? memGb : Math.round(memGb)} GB of usable memory. Estimates.
        </p>
        <div class="compat" role="table" aria-label="What fits on this hardware">
          <div class="compat-row compat-head" role="row" style="grid-template-columns:1.4fr 1fr 1fr 1fr">
            <span role="columnheader">Model</span><span role="columnheader">8K</span><span role="columnheader">16K</span><span role="columnheader">32K</span>
          </div>
          {fitRows.map((r) => (
            <div class="compat-row" role="row" style="grid-template-columns:1.4fr 1fr 1fr 1fr">
              <span role="cell">{r.name}</span>
              {r.cells.map((c) => (
                <span role="cell">
                  {c ? <span class:list={['fit-badge', c.fits ? 'fit-fits' : 'fit-oom']}>{c.t.toFixed(1)} GB {c.fits ? 'fits' : 'over'}</span> : 'n/a'}
                </span>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    {action && (
      <section class="callout mt-lg" aria-labelledby="limit-title">
        <p id="limit-title" class="kicker m-0">The limit</p>
        <p class="text-body-md text-primary m-0 mt-xs">{action.limit}</p>
        <p class="text-secondary m-0 mt-sm" style="font-size:.8rem">{action.links.some((l) => l.affiliate) ? AFFILIATE_DISCLOSURE : ''}</p>
        <ul class="aff-list mt-xs">
          {action.links.map((l) => (
            <li>
              <a href={l.href} {...(l.affiliate ? { target: '_blank', rel: AFFILIATE_REL, 'data-umami-event': `hw-${l.label}` } : {})} class="text-accent-primary font-bold">{l.text}</a>{l.affiliate ? ' (affiliate link)' : ''}
            </li>
          ))}
        </ul>
      </section>
    )}

    {fittingModels.length > 0 && (
      <div class="mt-lg">
        <h2 class="text-headline-lg text-primary mb-md">Models that fit this GPU</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
          {fittingModels.map((m) => (
            <a href={`/calculator/${m.slug}`}
              data-astro-prefetch
              class="border border-border rounded-md bg-surface p-md no-underline cursor-pointer
                transition-colors hover:border-accent-primary hover:bg-surface-elevated"
            >
              <p class="text-headline-md text-primary m-0">{m.title}</p>
              <p class="text-body-md text-secondary mt-xs mb-0">
                ~{m.bestTotalGb.toFixed(1)} GB at best-fitting quantization
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

    {relatedHw.length > 0 && (
      <section class="mt-lg" aria-labelledby="related-hw">
        <h2 id="related-hw" class="text-headline-md text-primary">Related hardware</h2>
        <ul class="post-related" style="grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))">
          {relatedHw.map((h) => (
            <li><a href={`/hardware/${h.slug}`} class="card-link post-pn-card"><span class="kicker">{h.data.category}</span><span>{h.data.title}</span></a></li>
          ))}
        </ul>
        <p class="mt-md"><a href="/hardware" class="text-accent-primary font-bold hover:underline">Back to the VRAM calculator and all hardware</a></p>
      </section>
    )}
  </div>
</BaseLayout>