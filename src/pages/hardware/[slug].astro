---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';

export async function getStaticPaths() {
  const entries = await getCollection('hardware');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, category, metricLabel, metricValue, status, summary, publishedAt } = entry.data;

const STATUS_LABELS: Record<string, string> = {
  verified: 'Verified',
  community: 'Community-reported',
  estimated: 'Estimated — not yet benchmarked',
};

const STATUS_STYLES: Record<string, string> = {
  verified: 'border-accent-tertiary text-accent-tertiary',
  community: 'border-border text-secondary',
  estimated: 'border-accent-secondary text-secondary',
};

const STATUS_SCHEMA_DESCRIPTIONS: Record<string, string> = {
  verified: `Verified benchmark: ${metricValue} ${metricLabel}`,
  community: `Community-reported value, not independently verified: ${metricValue} ${metricLabel}`,
  estimated: `Estimated value, not yet independently benchmarked: ${metricValue} ${metricLabel}`,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: summary,
    datePublished: publishedAt.toISOString(),
    about: {
      '@type': 'Dataset',
      name: `${title} — ${metricLabel}`,
      description: STATUS_SCHEMA_DESCRIPTIONS[status],
      variableMeasured: metricLabel,
      value: metricValue,
    },
  },
];
---

<BaseLayout title={title} description={summary} jsonLd={jsonLd}>
  <div class="max-w-reading mx-auto px-lg py-xl">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/hardware">Hardware</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="text-primary">{title}</span>
    </nav>

    <p class="text-body-md text-secondary font-mono uppercase tracking-wide">{category}</p>
    <h1 class="text-display-hero text-primary mt-xs">{title}</h1>
    <p class="text-body-lg text-secondary mt-sm">{summary}</p>

    <div class="hero-metric-card mt-lg">
      <span class="text-display-hero text-accent-primary font-mono">{metricValue}</span>
      <span class="text-body-lg text-secondary">{metricLabel}</span>
      <span class:list={['pill ml-auto', STATUS_STYLES[status]]}>{STATUS_LABELS[status]}</span>
    </div>

    <div class="flex items-center justify-between flex-wrap gap-sm mt-lg mb-md">
      <ArticleActions title={title} />
    </div>

    <div class="article-shell">
      <div class="docs-content">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>