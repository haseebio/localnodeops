---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleActions from '../../components/ArticleActions.astro';

export async function getStaticPaths() {
  const entries = await getCollection('hardware');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, category, metricLabel, metricValue, status, summary, publishedAt } = entry.data;

const STATUS_LABELS: Record<string, string> = {
  verified: 'Verified',
  community: 'Community-reported',
  estimated: 'Estimated — not yet benchmarked',
};

const STATUS_STYLES: Record<string, string> = {
  verified: 'border-accent-tertiary text-accent-tertiary',
  community: 'border-border text-secondary',
  estimated: 'border-accent-secondary text-secondary',
};

const STATUS_SCHEMA_DESCRIPTIONS: Record<string, string> = {
  verified: `Verified benchmark: ${metricValue} ${metricLabel}`,
  community: `Community-reported value, not independently verified: ${metricValue} ${metricLabel}`,
  estimated: `Estimated value, not yet independently benchmarked: ${metricValue} ${metricLabel}`,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: summary,
    datePublished: publishedAt.toISOString(),
    about: {
      '@type': 'Dataset',
      name: `${title} — ${metricLabel}`,
      description: STATUS_SCHEMA_DESCRIPTIONS[status],
      variableMeasured: metricLabel,
      value: metricValue,
    },
  },
];
---

<BaseLayout title={title} description={summary} jsonLd={jsonLd}>
  <article class="max-w-reading mx-auto px-lg py-xl">
    <p class="text-body-md text-secondary">{category}</p>
    <h1 class="text-display-hero text-primary mt-xs">{title}</h1>
    <p class="text-body-lg text-secondary mt-sm">{summary}</p>

    <div class="flex items-center gap-md mt-md flex-wrap">
      <div class="font-mono">
        <span class="text-headline-lg text-accent-primary">{metricValue}</span>
        <span class="text-body-md text-secondary ml-xs">{metricLabel}</span>
      </div>
      <span
        class:list={[
          'text-body-md rounded-full px-xs py-[0.125rem] border whitespace-nowrap',
          STATUS_STYLES[status],
        ]}
      >
        {STATUS_LABELS[status]}
      </span>
    </div>

    <div class="mt-lg">
      <ArticleActions title={title} />
    </div>

    <div class="article-shell mt-md">
      <div class="docs-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>