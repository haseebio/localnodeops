---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HardwareCard from '../../components/HardwareCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import CalcExtras from '../../components/CalcExtras.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { calculatorFaq } from '../../lib/calculator-faq';
import { AFFILIATE_DISCLOSURE } from '../../lib/affiliate';

const hardwareEntries = (await getCollection('hardware')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const categories = [...new Set(hardwareEntries.map((e) => e.data.category))];

// Real answers, matching exactly what the calculator's own footnote and
// the /methodology page state — no claim here that isn't true elsewhere
// on the site too.


const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hardware Benchmarks',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'LocalNodeOps VRAM Calculator',
    url: new URL('/hardware', Astro.site).toString(),
    description:
      'Estimates the VRAM needed to run a local language model from model size, quantization, context length and inference engine, and checks the result against common GPUs.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any (runs in a web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': new URL('/#organization', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: calculatorFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="VRAM Calculator: What Does a Local LLM Need?"
  description="Estimate VRAM for any local LLM: weights + KV cache + 10% overhead, exact .gguf sizes, llama.cpp and vLLM, multi-GPU. Free, no sign-up."
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-md sm:px-lg pt-md sm:pt-lg pb-sm">
    <h1 class="text-display-hero text-primary max-w-reading">VRAM Calculator: How Much VRAM Does This Model Need?</h1>
    <p class="text-body-md sm:text-body-lg text-secondary max-w-reading mt-xs">
      Pick a model, quantization and context length to see the total VRAM it needs.
      Free, no sign-up.
    </p>
  </section>

  <section class="max-w-shell mx-auto px-md sm:px-lg pb-xl">
    <VramCalculator />
    <CalcExtras />
        <p class="text-body-md text-secondary max-w-reading mt-md">
      Looking for one specific model? <a href="/calculator" class="text-accent-primary hover:underline">See the VRAM requirements for each synced model</a>.
    </p>
  </section>

  <section class="max-w-shell mx-auto px-md sm:px-lg pb-xl">
    <FAQAccordion items={calculatorFaq} title="Calculator FAQ" />
  </section>

  <section class="max-w-shell mx-auto px-md sm:px-lg pb-2xl">
    <h2 class="text-headline-lg text-primary">Hardware benchmarks</h2>
    <p class="text-body-md text-secondary max-w-reading mt-xs mb-md">
      Tokens-per-second, memory bandwidth, and quantization quality loss,
      tagged verified, community-reported, or estimated. Right now every
      entry is estimated: the figures come from third-party measurements,
      published papers or bandwidth calculations, and each entry says which.
      None has been measured on LocalNodeOps hardware yet.
    </p>
    <p class="text-secondary max-w-reading mb-md" style="font-size:.8rem">{AFFILIATE_DISCLOSURE}</p>
    <div class="mb-md">
      <CategoryFilter categories={categories} />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {hardwareEntries.map((entry) => (
        <HardwareCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>