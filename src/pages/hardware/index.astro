---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HardwareCard from '../../components/HardwareCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import VramCalculator from '../../components/VramCalculator.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const hardwareEntries = (await getCollection('hardware')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const categories = [...new Set(hardwareEntries.map((e) => e.data.category))];

// Real answers, matching exactly what the calculator's own footnote and
// the /methodology page state — no claim here that isn't true elsewhere
// on the site too.
const calculatorFaq = [
  {
    question: 'How accurate is the VRAM calculator?',
    answer:
      'It depends on the mode. In "Generic estimate" mode, both the model weight size and the KV cache figure are estimates based on a reference architecture for the selected size bucket. In "model-specific" mode, the weight size is exact (the real .gguf file size synced from Hugging Face). The KV cache is computed from the model\u2019s published attention settings when LocalNodeOps has them on record, and otherwise estimated from the nearest reference architecture. Either way the total assumes an fp16 cache, a batch size of 1 and a 10% runtime overhead, so treat it as an estimate.',
  },
  {
    question: 'Where does the KV cache figure come from for synced models?',
    answer:
      'KV cache size depends on a model\u2019s layer count, KV head count, and head dimension. The Hugging Face data this calculator syncs gives exact .gguf file sizes but no architecture details. For some models LocalNodeOps records the published attention settings and computes the KV cache from them. For the others, the calculator matches the nearest reference architecture (7B, 13B, 32B, 70B or 120B) by parsing an approximate parameter count from the model name, only when the match is within 5B and the model is not a mixture-of-experts. Otherwise no total is shown. See /methodology for the exact formula and its limitations.',
  },
  {
    question: 'Does more VRAM always mean I can run a bigger model?',
    answer:
      'No. VRAM is consumed by three separate things: model weights, KV cache, and runtime overhead. A long context window can consume more VRAM than the model weights themselves, especially on older MHA-style architectures. Sizing for weights alone is the most common mistake people make.',
  },
  {
    question: 'What does "Fits on" actually check?',
    answer:
      'It compares the estimated total VRAM (for vLLM, the total divided by 0.90) against the VRAM of the cards in the list, multiplied by the number of GPUs you choose. The list covers common consumer cards plus two workstation and datacenter cards (RTX 6000 Ada and A100) that are shown for reference only. It does not account for VRAM already in use by your OS, other applications, or a second model already loaded.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hardware Benchmarks',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'LocalNodeOps VRAM Calculator',
    url: new URL('/hardware', Astro.site).toString(),
    description:
      'Estimates the VRAM needed to run a local language model from model size, quantization, context length and inference engine, and checks the result against common GPUs.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any (runs in a web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': new URL('/#organization', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: calculatorFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Hardware Benchmarks for Local LLM Inference"
  description="Hardware benchmarks for GPUs, CPUs, memory, and quantization methods, tagged verified, community-reported, or estimated."
  jsonLd={jsonLd}
>
  <section class="max-w-shell mx-auto px-lg pt-2xl pb-md">
    <h1 class="text-display-hero text-primary max-w-reading">Hardware benchmarks</h1>
    <p class="text-body-lg text-secondary max-w-reading mt-md">
      Tokens-per-second, memory bandwidth, and quantization quality loss,
      tagged verified, community-reported, or estimated. Right now every
      entry is estimated: the figures come from third-party measurements,
      published papers or bandwidth calculations, and each entry says which.
      None has been measured on LocalNodeOps hardware yet.
    </p>
  </section>

  <section class="max-w-shell mx-auto px-lg pb-md">
    <div class="border border-border rounded-md bg-surface p-md flex items-center justify-between flex-wrap gap-sm">
      <span class="text-body-md text-primary">System status</span>
      <span class="flex items-center gap-xs text-body-md text-secondary">
        <span class="w-2 h-2 rounded-full bg-accent-tertiary" aria-hidden="true"></span>
        Static placeholder — not yet wired to live telemetry
      </span>
    </div>
  </section>

  <section class="max-w-shell mx-auto px-lg pb-xl">
    <VramCalculator />
  </section>

  <section class="max-w-shell mx-auto px-lg pb-xl">
    <FAQAccordion items={calculatorFaq} title="Calculator FAQ" />
  </section>

  <section class="max-w-shell mx-auto px-lg pb-2xl">
    <div class="mb-md">
      <CategoryFilter categories={categories} />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {hardwareEntries.map((entry) => (
        <HardwareCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>