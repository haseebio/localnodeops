---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact LocalNodeOps',
  },
];
---

<BaseLayout
  title="Contact LocalNodeOps"
  description="Reach LocalNodeOps for secure vulnerability disclosures via PGP-encrypted contact."
  jsonLd={jsonLd}
>
